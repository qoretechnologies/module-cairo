    # ---- Utility methods ----

    private hash<auto> invokeProvider(string dp_category, string dp_action, hash<auto> request) {
        try {
            CairoDataProvider root();
            AbstractDataProvider provider = root.getChildProviderEx(dp_category)
                .getChildProviderEx(dp_action);
            return provider.doRequest(request);
        } catch (hash<ExceptionInfo> ex) {
            die("%s: %s", ex.err, ex.desc);
        }
    }

    private list<hash<auto>> loadCommands() {
        string input_str;
        # Track whether the input is known to be YAML (from file extension)
        bool use_yaml = False;

        if (opts.commands_file) {
            if (opts.commands_file == "-") {
                input_str = stdin.read(-1);
            } else {
                input_str = ReadOnlyFile::readTextFile(opts.commands_file);
                # Detect format from file extension; YAML is preferred
                if (opts.commands_file =~ /\.ya?ml$/i) {
                    use_yaml = True;
                }
            }
        } else if (opts.commands) {
            input_str = opts.commands;
        } else if (!TerminalColor::isTerminal()) {
            input_str = stdin.read(-1);
        } else {
            die("draw commands required; use --commands-file <file>, --commands <yaml/json>, "
                "or pipe data to stdin");
        }

        auto parsed = parseData(input_str, use_yaml);

        if (parsed.typeCode() == NT_LIST) {
            return parsed;
        }
        if (parsed.typeCode() == NT_HASH && parsed.commands) {
            return parsed.commands;
        }
        die("invalid draw commands: expected a list of commands or an object with a "
            "'commands' key");
    }

    #! Parses input data as YAML or JSON; YAML is tried first when preferred or when
    #! the format is ambiguous
    private auto parseData(string input_str, bool prefer_yaml) {
        if (prefer_yaml) {
%ifdef NoYaml
            die("YAML module is required for .yaml/.yml files but is not available");
%else
            try {
                return parse_yaml(input_str);
            } catch (hash<ExceptionInfo> ex) {
                die("invalid YAML: %s", ex.desc);
            }
%endif
        }

        # For non-YAML files (JSON extension or unknown): try YAML first if available,
        # fall back to JSON
%ifndef NoYaml
        try {
            return parse_yaml(input_str);
        } catch () {
            # fall through to JSON
        }
%endif

%ifndef NoJson
        try {
            return parse_json(input_str);
        } catch (hash<ExceptionInfo> ex) {
%ifdef NoYaml
            die("invalid JSON: %s", ex.desc);
%else
            die("failed to parse as YAML or JSON: %s", ex.desc);
%endif
        }
%endif

%ifdef NoYaml
%ifdef NoJson
        die("neither YAML nor JSON modules are available; install at least one to use "
            "draw commands");
%endif
%endif
    }

    private string getInputFile() {
        if (!ARGV) {
            die("%s %s requires an input file argument", category, action);
        }
        string path = shift ARGV;
        if (!is_readable(path)) {
            die("input file %y not found or not readable", path);
        }
        return path;
    }

    private string getTextArg() {
        if (!ARGV) {
            die("text %s requires a text argument", action);
        }
        return shift ARGV;
    }

    private string getOutputPath(string input_path, string new_ext) {
        if (opts.output) {
            return opts.output;
        }
        if (opts.overwrite) {
            return input_path;
        }
        return deriveOutputPath(input_path, new_ext);
    }

    private string deriveOutputPath(string input_path, string new_ext) {
        # Replace extension: input.svg -> input.png
        *list<string> parts = (input_path =~ x/^(.+)\.([^.]+)$/);
        if (parts) {
            return parts[0] + "." + new_ext;
        }
        return input_path + "." + new_ext;
    }


    private printFontInfo(hash<auto> request) {
        string font_desc = request.family ?? "sans-serif";
        font_desc += sprintf(" %.0fpt", request.size ?? 12.0);
        if (request.weight && request.weight != "normal") {
            font_desc += " " + request.weight;
        }
        if (request.slant && request.slant != "normal") {
            font_desc += " " + request.slant;
        }
        printf("  %s  %s\n", color.key(sprintf("%-12s", "Font:")), color.type(font_desc));
    }

    private hash<auto> parseColor(string color_str) {
        list<string> parts = color_str.split(",");
        if (parts.size() < 3 || parts.size() > 4) {
            die("invalid color %y: expected r,g,b or r,g,b,a (floats 0.0-1.0)", color_str);
        }
        hash<auto> result = {
            "r": parts[0].toFloat(),
            "g": parts[1].toFloat(),
            "b": parts[2].toFloat(),
        };
        if (parts.size() == 4) {
            result.a = parts[3].toFloat();
        }
        return result;
    }

    private outputSuccess(string action_desc, hash<auto> response) {
        if (response.warnings) {
            foreach string w in (response.warnings) {
                printf("%s %s\n", color.warning("WARNING:"), w);
            }
        }

        string target;
        if (response.output_path) {
            target = response.output_path;
        } else if (response.output_location) {
            target = response.output_location;
        } else {
            target = "(overwritten)";
        }

        printf("%s %s", color.success(action_desc), color.key(target));
        if (exists response.size) {
            printf(" (%s bytes)", color.number(sprintf("%d", response.size)));
        }
        printf("\n");

        if (response.hasKey("width") && response.hasKey("height")) {
            printf("  %s %s px\n", color.key(sprintf("%-8s", "Width:")),
                color.number(sprintf("%d", response.width)));
            printf("  %s %s px\n", color.key(sprintf("%-8s", "Height:")),
                color.number(sprintf("%d", response.height)));
        }

        if ((opts.verbose ?? 0) > 0) {
            printf("\n%s\n", color.bold("Full response:"));
            printf("%s\n", color.formatValue(response, "  "));
        }
    }

    private requireSvgReader(string cmd) {
        if (!CairoSvgReader::isAvailable()) {
            die("%s requires librsvg, which is not available in this build", cmd);
        }
    }

    private requirePdfSupport(string cmd) {
        if (!CairoSurface::isPdfAvailable()) {
            die("%s requires PDF support, which is not available in this build", cmd);
        }
    }

    private requireDimensions(string cmd) {
        if (!exists opts.width || !exists opts.height) {
            die("%s requires -W <width> -H <height>", cmd);
        }
    }

    private die(string fmt) {
        printf("%s %s\n", color.error("ERROR:"), fmt);
        exit(1);
    }

    private die(string fmt, auto arg1) {
        printf("%s %s\n", color.error("ERROR:"), sprintf(fmt, arg1));
        exit(1);
    }

    private die(string fmt, auto arg1, auto arg2) {
        printf("%s %s\n", color.error("ERROR:"), sprintf(fmt, arg1, arg2));
        exit(1);
    }
}
