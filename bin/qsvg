%modern

%requires cairo
%requires CairoDataProvider
%requires DataProvider
%requires Util

%try-module yaml
%define NoYaml
%endtry

%try-module json
%define NoJson
%endtry

%exec-class QSvgMain

const VERSION = "1.0";

class QSvgMain {
    private {
        hash<auto> opts;
        *string category;
        *string action;
        Util::TerminalColor color;
    }

    public {
        const Opts = {
            # General
            "nocolor":        "C,no-color",
            "verbose":        "v,verbose:i+",
            "output":         "o,output=s",
            "overwrite":      "overwrite",
            "help":           "h,help",
            "version":        "V,version",

            # Dimensions
            "width":          "W,width=f",
            "height":         "H,height=f",

            # Draw commands
            "commands_file":  "commands-file=s",
            "commands":       "commands=s",

            # Image-specific
            "format":         "format=s",
            "angle":          "angle=f",
            "x":              "x=f",
            "y":              "y=f",
            "crop_width":     "crop-width=i",
            "crop_height":    "crop-height=i",
            "target_width":   "target-width=i",
            "target_height":  "target-height=i",

            # Composite
            "base":           "base=s",
            "overlay":        "overlay=s",
            "alpha":          "alpha=f",
            "overlay_width":  "overlay-width=i",
            "overlay_height": "overlay-height=i",

            # Text
            "family":         "family=s",
            "size":           "size=f",
            "slant":          "slant=s",
            "weight":         "weight=s",
            "color_opt":      "color=s",
            "bg_color":       "bg-color=s",
            "padding":        "padding=i",

            # PostScript
            "eps":            "eps",
        };
    }

    constructor() {
        GetOpt getopt(Opts);
        opts = getopt.parse3(\ARGV);

        color = new Util::TerminalColor(!opts.nocolor);

        if (opts.version) {
            printf("qsvg v%s\n", VERSION);
            exit(0);
        }

        if (opts.help && !ARGV) {
            doHelp(0);
        }

        if (!ARGV) {
            doHelp();
        }

        category = shift ARGV;

        if (category == "info") {
            doModuleInfo();
            return;
        }

        if (opts.help && !ARGV) {
            doCategoryHelp(category);
        }

        if (!ARGV) {
            doCategoryHelp(category);
        }

        action = shift ARGV;

        if (opts.help) {
            doCommandHelp(category, action);
        }

        dispatch();
    }

    private dispatch() {
        switch (category) {
            case "svg":
                dispatchSvg();
                break;
            case "image":
            case "img":
                dispatchImage();
                break;
            case "ps":
            case "postscript":
                dispatchPs();
                break;
            case "pdf":
                dispatchPdf();
                break;
            case "text":
                dispatchText();
                break;
            default:
                die("unknown category %y; valid categories: svg, image, ps, pdf, text, info", category);
        }
    }

    private dispatchSvg() {
        switch (action) {
            case "create":
                doSvgCreate();
                break;
            case "center":
                doSvgCenter();
                break;
            case "info":
                doSvgInfo();
                break;
            case "to-png":
                doSvgToPng();
                break;
            case "to-ps":
                doSvgToPs();
                break;
            case "to-eps":
                doSvgToEps();
                break;
            case "to-pdf":
                doSvgToPdf();
                break;
            default:
                die("unknown svg action %y; valid actions: create, center, info, to-png, "
                    "to-ps, to-eps, to-pdf", action);
        }
    }

    private dispatchImage() {
        switch (action) {
            case "create":
                doImageCreate();
                break;
            case "info":
                doImageInfo();
                break;
            case "draw":
                doImageDraw();
                break;
            case "resize":
                doImageResize();
                break;
            case "crop":
                doImageCrop();
                break;
            case "composite":
                doImageComposite();
                break;
            case "rotate":
                doImageRotate();
                break;
            case "to-svg":
                doImageToSvg();
                break;
            case "to-ps":
                doImageToPs();
                break;
            case "to-eps":
                doImageToEps();
                break;
            case "to-pdf":
                doImageToPdf();
                break;
            default:
                die("unknown image action %y; valid actions: create, info, draw, resize, crop, "
                    "composite, rotate, to-svg, to-ps, to-eps, to-pdf", action);
        }
    }

    private dispatchPs() {
        switch (action) {
            case "create":
                doPsCreate();
                break;
            default:
                die("unknown ps action %y; valid actions: create", action);
        }
    }

    private dispatchPdf() {
        switch (action) {
            case "create":
                doPdfCreate();
                break;
            default:
                die("unknown pdf action %y; valid actions: create", action);
        }
    }

    private dispatchText() {
        switch (action) {
            case "measure":
                doTextMeasure();
                break;
            case "metrics":
                doTextMetrics();
                break;
            case "render":
                doTextRender();
                break;
            default:
                die("unknown text action %y; valid actions: measure, metrics, render", action);
        }
    }

    # ---- SVG commands ----

    private doSvgCreate() {
        if (!opts.output) {
            die("svg create requires -o <output-file>");
        }
        requireDimensions("svg create");
        list<hash<auto>> commands = loadCommands();

        hash<auto> request = {
            "width": opts.width,
            "height": opts.height,
            "commands": commands,
            "output_path": opts.output,
        };

        hash<auto> response = invokeProvider("svg", "create", request);
        outputSuccess("Created SVG", response);
    }

    private doSvgCenter() {
        requireSvgReader("svg center");
        string input_path = getInputFile();

        hash<auto> request = {
            "input_path": input_path,
            "overwrite": True,
        };
        # If -o is given, write there instead of overwriting
        if (opts.output) {
            delete request.overwrite;
            request.output_path = opts.output;
        }

        hash<auto> response = invokeProvider("svg", "center", request);

        string target = response.output_path ?? input_path;
        printf("%s %s (%s bytes)\n", color.success("Centered"), color.key(target),
            color.number(sprintf("%d", response.size)));
        printf("  %s %s -> %s pt\n",
            color.key(sprintf("%-10s", "Width:")),
            color.number(sprintf("%.1f", response.original_width)),
            color.number(sprintf("%.1f", response.canvas_size)));
        printf("  %s %s -> %s pt\n",
            color.key(sprintf("%-10s", "Height:")),
            color.number(sprintf("%.1f", response.original_height)),
            color.number(sprintf("%.1f", response.canvas_size)));
        if (response.warnings) {
            foreach string w in (response.warnings) {
                printf("%s %s\n", color.warning("WARNING:"), w);
            }
        }
        if ((opts.verbose ?? 0) > 0) {
            printf("\n%s\n", color.bold("Full response:"));
            printf("%s\n", color.formatValue(response, "  "));
        }
    }

    private doSvgInfo() {
        requireSvgReader("svg info");
        string input_path = getInputFile();

        hash<auto> response = invokeProvider("svg", "get-info", {
            "input_path": input_path,
        });

        printf("%s %s\n", color.bold("File:"), color.key(input_path));
        printf("  %s  %s pt\n", color.key(sprintf("%-8s", "Width:")),
            color.number(sprintf("%.1f", response.width)));
        printf("  %s  %s pt\n", color.key(sprintf("%-8s", "Height:")),
            color.number(sprintf("%.1f", response.height)));
        if (response.metadata) {
            printf("  %s\n", color.key("Metadata:"));
            foreach hash<auto> pair in (response.metadata.pairIterator()) {
                printf("    %s: %s\n", color.dim(pair.key), color.value(sprintf("%y", pair.value)));
            }
        }
        if ((opts.verbose ?? 0) > 0) {
            printf("\n%s\n", color.bold("Full response:"));
            printf("%s\n", color.formatValue(response, "  "));
        }
    }

    private doSvgToPng() {
        requireSvgReader("svg to-png");
        string input_path = getInputFile();
        string output_path = getOutputPath(input_path, "png");

        hash<auto> request = {
            "input_path": input_path,
            "output_path": output_path,
            "width": exists opts.width ? int(opts.width) : NOTHING,
            "height": exists opts.height ? int(opts.height) : NOTHING,
        };

        hash<auto> response = invokeProvider("svg", "to-png", request);
        outputSuccess("Converted to PNG", response);
    }

    private doSvgToPs() {
        requireSvgReader("svg to-ps");
        string input_path = getInputFile();
        string output_path = getOutputPath(input_path, "ps");

        hash<auto> request = {
            "input_path": input_path,
            "output_path": output_path,
            "width": opts.width,
            "height": opts.height,
        };

        hash<auto> response = invokeProvider("svg", "to-ps", request);
        outputSuccess("Converted to PostScript", response);
    }

    private doSvgToEps() {
        requireSvgReader("svg to-eps");
        string input_path = getInputFile();
        string output_path = getOutputPath(input_path, "eps");

        hash<auto> request = {
            "input_path": input_path,
            "output_path": output_path,
            "width": opts.width,
            "height": opts.height,
        };

        hash<auto> response = invokeProvider("svg", "to-eps", request);
        outputSuccess("Converted to EPS", response);
    }

    private doSvgToPdf() {
        requireSvgReader("svg to-pdf");
        requirePdfSupport("svg to-pdf");
        string input_path = getInputFile();
        string output_path = getOutputPath(input_path, "pdf");

        hash<auto> request = {
            "input_path": input_path,
            "output_path": output_path,
            "width": opts.width,
            "height": opts.height,
        };

        hash<auto> response = invokeProvider("svg", "to-pdf", request);
        outputSuccess("Converted to PDF", response);
    }

    # ---- Image commands ----

    private doImageCreate() {
        if (!opts.output) {
            die("image create requires -o <output-file>");
        }
        requireDimensions("image create");
        list<hash<auto>> commands = loadCommands();

        hash<auto> request = {
            "width": int(opts.width),
            "height": int(opts.height),
            "commands": commands,
            "output_path": opts.output,
        };
        if (exists opts.format) {
            request.format = opts.format;
        }

        hash<auto> response = invokeProvider("image", "create", request);
        outputSuccess("Created image", response);
    }

    private doImageInfo() {
        string input_path = getInputFile();

        hash<auto> response = invokeProvider("image", "get-info", {
            "input_path": input_path,
        });

        printf("%s %s\n", color.bold("File:"), color.key(input_path));
        printf("  %s  %s px\n", color.key(sprintf("%-8s", "Width:")),
            color.number(sprintf("%d", response.width)));
        printf("  %s  %s px\n", color.key(sprintf("%-8s", "Height:")),
            color.number(sprintf("%d", response.height)));
        printf("  %s  %s\n", color.key(sprintf("%-8s", "Type:")),
            color.type(response.type));
        if (response.format) {
            printf("  %s  %s\n", color.key(sprintf("%-8s", "Format:")),
                color.type(response.format));
        }
        if ((opts.verbose ?? 0) > 0) {
            printf("\n%s\n", color.bold("Full response:"));
            printf("%s\n", color.formatValue(response, "  "));
        }
    }

    private doImageDraw() {
        string input_path = getInputFile();
        list<hash<auto>> commands = loadCommands();

        hash<auto> request = {
            "input_path": input_path,
            "commands": commands,
        };
        if (opts.overwrite) {
            request.overwrite = True;
        } else {
            request.output_path = getOutputPath(input_path, "png");
        }

        hash<auto> response = invokeProvider("image", "draw", request);
        outputSuccess("Drew on image", response);
    }

    private doImageResize() {
        string input_path = getInputFile();

        if (!exists opts.target_width || !exists opts.target_height) {
            die("image resize requires --target-width and --target-height");
        }

        hash<auto> request = {
            "input_path": input_path,
            "target_width": opts.target_width,
            "target_height": opts.target_height,
        };
        if (opts.overwrite) {
            request.overwrite = True;
        } else {
            request.output_path = getOutputPath(input_path, "png");
        }

        hash<auto> response = invokeProvider("image", "resize", request);
        outputSuccess("Resized image", response);
    }

    private doImageCrop() {
        string input_path = getInputFile();

        if (!exists opts.x || !exists opts.y || !exists opts.crop_width
                || !exists opts.crop_height) {
            die("image crop requires -x, -y, --crop-width, and --crop-height");
        }

        hash<auto> request = {
            "input_path": input_path,
            "x": int(opts.x),
            "y": int(opts.y),
            "crop_width": opts.crop_width,
            "crop_height": opts.crop_height,
        };
        if (opts.overwrite) {
            request.overwrite = True;
        } else {
            request.output_path = getOutputPath(input_path, "png");
        }

        hash<auto> response = invokeProvider("image", "crop", request);
        outputSuccess("Cropped image", response);
    }

    private doImageComposite() {
        if (!opts.base) {
            die("image composite requires --base <base-image>");
        }
        if (!opts.overlay) {
            die("image composite requires --overlay <overlay-image>");
        }
        if (!opts.output) {
            die("image composite requires -o <output-file>");
        }

        hash<auto> request = {
            "base_input_path": opts.base,
            "overlay_input_path": opts.overlay,
            "output_path": opts.output,
            "return_data": False,
            "x": opts.x,
            "y": opts.y,
            "alpha": opts.alpha,
            "overlay_width": opts.overlay_width,
            "overlay_height": opts.overlay_height,
        };

        hash<auto> response = invokeProvider("image", "composite", request);
        outputSuccess("Composited image", response);
    }

    private doImageRotate() {
        string input_path = getInputFile();

        if (!exists opts.angle) {
            die("image rotate requires --angle <degrees>");
        }

        hash<auto> request = {
            "input_path": input_path,
            "angle": opts.angle,
        };
        if (opts.overwrite) {
            request.overwrite = True;
        } else {
            request.output_path = getOutputPath(input_path, "png");
        }

        hash<auto> response = invokeProvider("image", "rotate", request);
        outputSuccess("Rotated image", response);
    }

    private doImageToSvg() {
        string input_path = getInputFile();
        string output_path = getOutputPath(input_path, "svg");

        hash<auto> request = {
            "input_path": input_path,
            "output_path": output_path,
        };

        hash<auto> response = invokeProvider("image", "to-svg", request);
        outputSuccess("Converted to SVG", response);
    }

    private doImageToPs() {
        string input_path = getInputFile();
        string output_path = getOutputPath(input_path, "ps");

        hash<auto> response = invokeProvider("image", "to-ps", {
            "input_path": input_path,
            "output_path": output_path,
        });
        outputSuccess("Converted to PostScript", response);
    }

    private doImageToEps() {
        string input_path = getInputFile();
        string output_path = getOutputPath(input_path, "eps");

        hash<auto> response = invokeProvider("image", "to-eps", {
            "input_path": input_path,
            "output_path": output_path,
        });
        outputSuccess("Converted to EPS", response);
    }

    private doImageToPdf() {
        requirePdfSupport("image to-pdf");
        string input_path = getInputFile();
        string output_path = getOutputPath(input_path, "pdf");

        hash<auto> response = invokeProvider("image", "to-pdf", {
            "input_path": input_path,
            "output_path": output_path,
        });
        outputSuccess("Converted to PDF", response);
    }

    # ---- PostScript commands ----

    private doPsCreate() {
        if (!opts.output) {
            die("ps create requires -o <output-file>");
        }
        requireDimensions("ps create");
        list<hash<auto>> commands = loadCommands();

        hash<auto> request = {
            "width": opts.width,
            "height": opts.height,
            "commands": commands,
            "output_path": opts.output,
        };
        if (opts.eps) {
            request.eps = True;
        }

        hash<auto> response = invokeProvider("postscript", "create", request);
        outputSuccess(opts.eps ? "Created EPS" : "Created PostScript", response);
    }

    # ---- PDF commands ----

    private doPdfCreate() {
        requirePdfSupport("pdf create");
        if (!opts.output) {
            die("pdf create requires -o <output-file>");
        }
        requireDimensions("pdf create");
        list<hash<auto>> commands = loadCommands();

        hash<auto> request = {
            "width": opts.width,
            "height": opts.height,
            "commands": commands,
            "output_path": opts.output,
        };

        hash<auto> response = invokeProvider("pdf", "create", request);
        outputSuccess("Created PDF", response);
    }

    # ---- Text commands ----

    private doTextMeasure() {
        string text = getTextArg();

        hash<auto> request = {
            "text": text,
            "family": opts.family,
            "size": opts.size,
            "slant": opts.slant,
            "weight": opts.weight,
        };

        hash<auto> response = invokeProvider("text", "measure", request);

        printf("%s %s\n", color.bold("Text:"), color.str(sprintf("%y", text)));
        printFontInfo(request);
        printf("  %s  %s\n", color.key(sprintf("%-12s", "Width:")),
            color.number(sprintf("%.2f", response.width)));
        printf("  %s  %s\n", color.key(sprintf("%-12s", "Height:")),
            color.number(sprintf("%.2f", response.height)));
        printf("  %s  %s\n", color.key(sprintf("%-12s", "X bearing:")),
            color.number(sprintf("%.2f", response.x_bearing)));
        printf("  %s  %s\n", color.key(sprintf("%-12s", "Y bearing:")),
            color.number(sprintf("%.2f", response.y_bearing)));
        printf("  %s  %s\n", color.key(sprintf("%-12s", "X advance:")),
            color.number(sprintf("%.2f", response.x_advance)));
        printf("  %s  %s\n", color.key(sprintf("%-12s", "Y advance:")),
            color.number(sprintf("%.2f", response.y_advance)));
        if ((opts.verbose ?? 0) > 0) {
            printf("\n%s\n", color.bold("Full response:"));
            printf("%s\n", color.formatValue(response, "  "));
        }
    }

    private doTextMetrics() {
        hash<auto> request = {
            "family": opts.family,
            "size": opts.size,
            "slant": opts.slant,
            "weight": opts.weight,
        };

        hash<auto> response = invokeProvider("text", "get-font-metrics", request);

        printf("%s\n", color.bold("Font Metrics:"));
        printFontInfo(request);
        printf("  %s  %s\n", color.key(sprintf("%-16s", "Ascent:")),
            color.number(sprintf("%.2f", response.ascent)));
        printf("  %s  %s\n", color.key(sprintf("%-16s", "Descent:")),
            color.number(sprintf("%.2f", response.descent)));
        printf("  %s  %s\n", color.key(sprintf("%-16s", "Height:")),
            color.number(sprintf("%.2f", response.height)));
        printf("  %s  %s\n", color.key(sprintf("%-16s", "Max X advance:")),
            color.number(sprintf("%.2f", response.max_x_advance)));
        printf("  %s  %s\n", color.key(sprintf("%-16s", "Max Y advance:")),
            color.number(sprintf("%.2f", response.max_y_advance)));
        if ((opts.verbose ?? 0) > 0) {
            printf("\n%s\n", color.bold("Full response:"));
            printf("%s\n", color.formatValue(response, "  "));
        }
    }

    private doTextRender() {
        string text = getTextArg();
        if (!opts.output) {
            die("text render requires -o <output-file>");
        }

        hash<auto> request = {
            "text": text,
            "output_path": opts.output,
            "family": opts.family,
            "size": opts.size,
            "slant": opts.slant,
            "weight": opts.weight,
        };

        if (exists opts.color_opt) {
            hash<auto> rgba = parseColor(opts.color_opt);
            request += rgba;
        }
        if (exists opts.bg_color) {
            hash<auto> bg = parseColor(opts.bg_color);
            request.bg_r = bg.r;
            request.bg_g = bg.g;
            request.bg_b = bg.b;
            if (exists bg.a) {
                request.bg_a = bg.a;
            }
        }
        if (exists opts.padding) {
            request.padding = opts.padding;
        }

        hash<auto> response = invokeProvider("text", "render", request);
        outputSuccess("Rendered text", response);
    }

    # ---- Module info ----

    private doModuleInfo() {
        printf("%s v%s\n\n", color.bold("qsvg"), VERSION);

        printf("%s\n", color.bold("Cairo Module Capabilities:"));
        bool svg_reader = CairoSvgReader::isAvailable();
        bool pdf_support = CairoSurface::isPdfAvailable();
        printf("  %s  %s\n", color.key(sprintf("%-14s", "librsvg:")),
            svg_reader ? color.success("available")
                : color.error("not available") + color.dim(" (SVG input/conversion disabled)"));
        printf("  %s  %s\n", color.key(sprintf("%-14s", "PDF support:")),
            pdf_support ? color.success("available")
                : color.error("not available") + color.dim(" (PDF creation disabled)"));

        printf("\n%s\n", color.bold("Available Commands:"));
        printf("  %s  create, center%s, info%s, to-png%s, to-ps%s, to-eps%s, to-pdf%s\n",
            color.key(sprintf("%-10s", "svg")),
            svg_reader ? "" : color.dim("*"),
            svg_reader ? "" : color.dim("*"),
            svg_reader ? "" : color.dim("*"),
            svg_reader ? "" : color.dim("*"),
            svg_reader ? "" : color.dim("*"),
            svg_reader && pdf_support ? "" : color.dim("*"));
        printf("  %s  create, info, draw, resize, crop, composite, rotate,\n",
            color.key(sprintf("%-10s", "image")));
        printf("  %s  to-svg, to-ps, to-eps, to-pdf%s\n",
            sprintf("%-10s", ""),
            pdf_support ? "" : color.dim("*"));
        printf("  %s  create\n", color.key(sprintf("%-10s", "ps")));
        if (pdf_support) {
            printf("  %s  create\n", color.key(sprintf("%-10s", "pdf")));
        } else {
            printf("  %s  create%s\n", color.key(sprintf("%-10s", "pdf")), color.dim("*"));
        }
        printf("  %s  measure, metrics, render\n", color.key(sprintf("%-10s", "text")));

        if (!svg_reader || !pdf_support) {
            printf("\n  %s requires a feature not available in this build\n", color.dim("*"));
        }
    }

    # ---- Help system ----

    private doHelp(int exit_code = 1) {
        printf("%s v%s - Cairo vector graphics CLI\n\n", color.bold("qsvg"), VERSION);

        printf("%s\n", color.bold("Usage:"));
        printf("  qsvg <category> <action> [input-file] [options]\n");

        printf("\n%s\n", color.bold("Categories:"));
        printf("  %s  SVG creation and conversion\n", color.key(sprintf("%-10s", "svg")));
        printf("  %s  PNG image creation and manipulation\n",
            color.key(sprintf("%-10s", "image")));
        printf("  %s  PostScript/EPS creation\n", color.key(sprintf("%-10s", "ps")));
        printf("  %s  PDF document creation\n", color.key(sprintf("%-10s", "pdf")));
        printf("  %s  Text measurement and rendering\n", color.key(sprintf("%-10s", "text")));

        printf("\n%s\n", color.bold("Global Commands:"));
        printf("  %s  Show Cairo module capabilities\n", color.key(sprintf("%-10s", "info")));

        printf("\n%s\n", color.bold("Common Options:"));
        printf("  %s                Output file path\n", color.key("-o, --output <file>"));
        printf("  %s                     Overwrite input file\n", color.key("    --overwrite"));
        printf("  %s               Width (pixels or points)\n", color.key("-W, --width <value>"));
        printf("  %s              Height (pixels or points)\n", color.key("-H, --height <value>"));
        printf("  %s    Read draw commands from YAML/JSON file\n", color.key("    --commands-file <f>"));
        printf("  %s                    Disable color output\n", color.key("-C, --no-color"));
        printf("  %s                     Increase verbosity\n", color.key("-v, --verbose"));
        printf("  %s                        Show this help\n", color.key("-h, --help"));
        printf("  %s                     Show version\n", color.key("-V, --version"));

        printf("\n%s\n", color.bold("Examples:"));
        printf("  %s\n", color.dim("# Convert SVG to PNG:"));
        printf("  qsvg svg to-png logo.svg -o logo.png\n");
        printf("  %s\n", color.dim("# Resize an image:"));
        printf("  qsvg image resize photo.png --target-width 400 --target-height 300 -o thumb.png\n");
        printf("  %s\n", color.dim("# Measure text:"));
        printf("  qsvg text measure \"Hello World\" --family Helvetica --size 24\n");
        printf("  %s\n", color.dim("# Create SVG from draw commands:"));
        printf("  qsvg svg create -W 200 -H 200 --commands-file drawing.json -o out.svg\n");

        printf("\nRun %s for category-specific help.\n",
            color.key("qsvg <category> --help"));
        exit(exit_code);
    }

    private doCategoryHelp(string cat) {
        switch (cat) {
            case "svg":
                doSvgHelp();
                break;
            case "image":
            case "img":
                doImageHelp();
                break;
            case "ps":
            case "postscript":
                doPsHelp();
                break;
            case "pdf":
                doPdfHelp();
                break;
            case "text":
                doTextHelp();
                break;
            default:
                die("unknown category %y; valid categories: svg, image, ps, pdf, text, info",
                    cat);
        }
    }

