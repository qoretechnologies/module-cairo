#include "QC_CairoSurface.h"
#include "CairoSurface.h"

//! Surface information
/**
    Contains information about a Cairo surface.
*/
hashdecl Qore::Cairo::CairoSurfaceInfo {
    //! Surface type: "svg", "ps", "pdf", "image", or "recording"
    /** */
    string type;

    //! Surface width
    /** */
    float width;

    //! Surface height
    /** */
    float height;

    //! Image format (only for image surfaces): "ARGB32", "RGB24", "A8", "A1"
    /** */
    *string format;
}

//! Matrix for affine transformations
/**
    A 2D affine transformation matrix.
*/
hashdecl Qore::Cairo::CairoMatrix {
    //! xx component
    /** */
    float xx;

    //! yx component
    /** */
    float yx;

    //! xy component
    /** */
    float xy;

    //! yy component
    /** */
    float yy;

    //! x0 (x translation) component
    /** */
    float x0;

    //! y0 (y translation) component
    /** */
    float y0;
}

//! Text extents information
/**
    Contains the extents of a text string.
*/
hashdecl Qore::Cairo::CairoTextExtents {
    //! X bearing
    /** */
    float x_bearing;

    //! Y bearing
    /** */
    float y_bearing;

    //! Width of the text
    /** */
    float width;

    //! Height of the text
    /** */
    float height;

    //! X advance
    /** */
    float x_advance;

    //! Y advance
    /** */
    float y_advance;
}

//! Font extents information
/**
    Contains metrics for the currently selected font.
*/
hashdecl Qore::Cairo::CairoFontExtents {
    //! Distance the font extends above the baseline
    /** */
    float ascent;

    //! Distance the font extends below the baseline
    /** */
    float descent;

    //! Recommended vertical distance between baselines
    /** */
    float height;

    //! Maximum distance in X a glyph advances
    /** */
    float max_x_advance;

    //! Maximum distance in Y a glyph advances
    /** */
    float max_y_advance;
}

//! Current point coordinates
/**
    Contains the current point of a Cairo path.
*/
hashdecl Qore::Cairo::CairoPoint {
    //! X coordinate
    /** */
    float x;

    //! Y coordinate
    /** */
    float y;
}

//! Path bounding box
/**
    Contains the bounding box of a Cairo path in user-space coordinates.
*/
hashdecl Qore::Cairo::CairoPathExtents {
    //! Left edge X coordinate
    /** */
    float x1;

    //! Top edge Y coordinate
    /** */
    float y1;

    //! Right edge X coordinate
    /** */
    float x2;

    //! Bottom edge Y coordinate
    /** */
    float y2;
}

//! A Cairo drawing surface
/**
    Wraps a Cairo surface for rendering to SVG, PostScript, EPS, PNG, and in-memory targets.

    @since %cairo 1.0
*/
qclass CairoSurface [arg=QoreCairoSurface* surface; ns=Qore::Cairo];

//! Private constructor - use static factory methods instead
/** @throw CAIRO-ERROR always; CairoSurface objects must be created using static factory methods
*/
private CairoSurface::constructor() {
    xsink->raiseException("CAIRO-ERROR", "CairoSurface cannot be constructed directly; use static factory methods");
}

//! Creates an SVG surface writing to a file
/** @param path output file path
    @param width surface width in points
    @param height surface height in points

    @throw CAIRO-ERROR if the surface cannot be created
*/
static CairoSurface CairoSurface::createSvg(string path, float width, float height) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    ReferenceHolder<QoreCairoSurface> holder(new QoreCairoSurface(path->c_str(), width, height, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_CAIROSURFACE, getProgram(), holder.release());
}

//! Creates an SVG surface writing to memory
/** @param width surface width in points
    @param height surface height in points

    @return a new CairoSurface; use getData() to get the SVG data after finish()

    @throw CAIRO-ERROR if the surface cannot be created
*/
static CairoSurface CairoSurface::createSvgToData(float width, float height) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreCairoSurface> holder(new QoreCairoSurface(width, height, true, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_CAIROSURFACE, getProgram(), holder.release());
}

//! Creates a PostScript surface writing to a file
/** @param path output file path
    @param width surface width in points
    @param height surface height in points

    @throw CAIRO-ERROR if the surface cannot be created
*/
static CairoSurface CairoSurface::createPs(string path, float width, float height) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    ReferenceHolder<QoreCairoSurface> holder(new QoreCairoSurface(path->c_str(), width, height, true, xsink),
        xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_CAIROSURFACE, getProgram(), holder.release());
}

//! Creates a PostScript surface writing to memory
/** @param width surface width in points
    @param height surface height in points

    @return a new CairoSurface; use getData() to get the PS data after finish()

    @throw CAIRO-ERROR if the surface cannot be created
*/
static CairoSurface CairoSurface::createPsToData(float width, float height) [flags=NAMED_ARGS] {
    ReferenceHolder<QoreCairoSurface> holder(new QoreCairoSurface(width, height, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_CAIROSURFACE, getProgram(), holder.release());
}

//! Creates an image surface
/** @param width image width in pixels
    @param height image height in pixels
    @param format pixel format: "ARGB32" (default), "RGB24", "A8", "A1"

    @throw CAIRO-ERROR if the surface cannot be created
*/
static CairoSurface CairoSurface::createImage(int width, int height, *string format = "ARGB32") [flags=NAMED_ARGS] {
    cairo_format_t fmt = CAIRO_FORMAT_ARGB32;
    if (format && !format->empty()) {
        const char* fmt_str = format->c_str();
        if (!strcmp(fmt_str, "ARGB32")) {
            fmt = CAIRO_FORMAT_ARGB32;
        } else if (!strcmp(fmt_str, "RGB24")) {
            fmt = CAIRO_FORMAT_RGB24;
        } else if (!strcmp(fmt_str, "A8")) {
            fmt = CAIRO_FORMAT_A8;
        } else if (!strcmp(fmt_str, "A1")) {
            fmt = CAIRO_FORMAT_A1;
        } else {
            xsink->raiseException("CAIRO-ERROR",
                "invalid image format '%s'; valid values: ARGB32, RGB24, A8, A1", fmt_str);
            return QoreValue();
        }
    }
    ReferenceHolder<QoreCairoSurface> holder(new QoreCairoSurface(width, height, fmt, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_CAIROSURFACE, getProgram(), holder.release());
}

//! Creates an image surface from a PNG file
/** @param path PNG file path

    @throw CAIRO-ERROR if the PNG cannot be loaded
*/
static CairoSurface CairoSurface::createImageFromPng(string path) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    ReferenceHolder<QoreCairoSurface> holder(new QoreCairoSurface(path->c_str(), xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_CAIROSURFACE, getProgram(), holder.release());
}

//! Creates an image surface from PNG binary data
/** @param data PNG binary data

    @throw CAIRO-ERROR if the PNG data cannot be loaded
*/
static CairoSurface CairoSurface::createImageFromPngData(binary data) [flags=NAMED_ARGS] {
    if (!data || data->size() == 0) {
        xsink->raiseException("CAIRO-ERROR", "PNG data is empty");
        return QoreValue();
    }
    ReferenceHolder<QoreCairoSurface> holder(new QoreCairoSurface(data, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_CAIROSURFACE, getProgram(), holder.release());
}

//! Creates a recording surface
/** @param x optional x origin for the recording extents
    @param y optional y origin for the recording extents
    @param width optional width for the recording extents
    @param height optional height for the recording extents

    @note If all four parameters are provided, the recording surface will be bounded.
    If none are provided, the surface is unbounded.
*/
static CairoSurface CairoSurface::createRecording(*float x, *float y, *float width, *float height) [flags=NAMED_ARGS] {
    bool has_extents = !get_param_value(args, 0).isNothing()
        && !get_param_value(args, 1).isNothing()
        && !get_param_value(args, 2).isNothing()
        && !get_param_value(args, 3).isNothing();
    ReferenceHolder<QoreCairoSurface> holder(new QoreCairoSurface(x, y, width, height, has_extents, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_CAIROSURFACE, getProgram(), holder.release());
}

//! Finalizes the surface
/** After calling finish(), no more drawing operations should be performed on this surface.
    For stream-based surfaces, the stream data becomes available via getData().

    @throw CAIRO-ERROR if the surface is not initialized
*/
nothing CairoSurface::finish() {
    surface->finish(xsink);
}

//! Flushes pending output
/** @throw CAIRO-ERROR if the surface is not initialized
*/
nothing CairoSurface::flush() {
    surface->flush(xsink);
}

//! Writes the surface to a PNG file
/** Only available for image and recording surfaces.
    @param path output PNG file path

    @throw CAIRO-ERROR if the surface cannot be written as PNG
*/
nothing CairoSurface::writeToPng(string path) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    surface->writeToPng(path->c_str(), xsink);
}

//! Writes the surface to PNG binary data
/** Only available for image and recording surfaces.
    @return binary PNG data

    @throw CAIRO-ERROR if the surface cannot be written as PNG
*/
binary CairoSurface::writeToPngData() {
    return surface->writeToPngData(xsink);
}

//! Gets accumulated stream data
/** Only available for stream-based surfaces (createSvgToData, createPsToData, createPdfToData).
    Call finish() before calling this method to ensure all data is written.

    @return binary data (SVG XML, PostScript, or PDF)

    @throw CAIRO-ERROR if not a stream-based surface
*/
binary CairoSurface::getData() {
    return surface->getData(xsink);
}

//! Returns the surface width
/** @return surface width in points or pixels
*/
int CairoSurface::getWidth() {
    return surface->getWidth(xsink);
}

//! Returns the surface height
/** @return surface height in points or pixels
*/
int CairoSurface::getHeight() {
    return surface->getHeight(xsink);
}

//! Returns surface information
/** @return a @ref Qore::Cairo::CairoSurfaceInfo hash

    @throw CAIRO-ERROR if the surface is not initialized
*/
hash<CairoSurfaceInfo> CairoSurface::getInfo() {
    return surface->getInfo(xsink);
}

//! Sets EPS mode for PostScript surfaces
/** @param eps True to enable EPS mode

    @throw CAIRO-ERROR if not a PostScript surface
*/
nothing CairoSurface::setEps(bool eps) [flags=NAMED_ARGS] {
    surface->setEps(eps, xsink);
}

//! Sets page size for PostScript surfaces
/** @param width new page width in points
    @param height new page height in points

    @throw CAIRO-ERROR if not a PostScript surface
*/
nothing CairoSurface::setPsSize(float width, float height) [flags=NAMED_ARGS] {
    surface->setPsSize(width, height, xsink);
}

//! Creates a PDF surface writing to a file
/** @param path output file path
    @param width surface width in points
    @param height surface height in points

    @throw CAIRO-ERROR if PDF support is not available or the surface cannot be created
*/
static CairoSurface CairoSurface::createPdf(string path, float width, float height) [dom=FILESYSTEM;flags=NAMED_ARGS] {
#ifdef HAVE_CAIRO_PDF
    ReferenceHolder<QoreCairoSurface> holder(new QoreCairoSurface(path->c_str(), width, height,
        QoreCairoSurface::PdfTag{}, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_CAIROSURFACE, getProgram(), holder.release());
#else
    xsink->raiseException("CAIRO-ERROR", "PDF surface support not available");
    return QoreValue();
#endif
}

//! Creates a PDF surface writing to memory
/** @param width surface width in points
    @param height surface height in points

    @return a new CairoSurface; use getData() to get the PDF data after finish()

    @throw CAIRO-ERROR if PDF support is not available or the surface cannot be created
*/
static CairoSurface CairoSurface::createPdfToData(float width, float height) [flags=NAMED_ARGS] {
#ifdef HAVE_CAIRO_PDF
    ReferenceHolder<QoreCairoSurface> holder(new QoreCairoSurface(width, height,
        QoreCairoSurface::PdfTag{}, xsink), xsink);
    if (*xsink) {
        return QoreValue();
    }
    return new QoreObject(QC_CAIROSURFACE, getProgram(), holder.release());
#else
    xsink->raiseException("CAIRO-ERROR", "PDF surface support not available");
    return QoreValue();
#endif
}

//! Sets page size for PDF surfaces
/** @param width new page width in points
    @param height new page height in points

    @throw CAIRO-ERROR if not a PDF surface or PDF support is not available
*/
nothing CairoSurface::setPdfSize(float width, float height) [flags=NAMED_ARGS] {
#ifdef HAVE_CAIRO_PDF
    surface->setPdfSize(width, height, xsink);
#else
    xsink->raiseException("CAIRO-ERROR", "PDF surface support not available");
#endif
}

//! Returns whether PDF surface support is available
/** @return True if PDF surface support was compiled in
*/
static bool CairoSurface::isPdfAvailable() {
    return QoreCairoSurface::isPdfAvailable();
}

//! Advances to the next page
/** For multi-page surfaces (PostScript, PDF, SVG 1.2+).
*/
nothing CairoSurface::showPage() {
    surface->showPage(xsink);
}

//! Returns the ink extents of a recording surface
/** Returns the bounding box of actual drawn content on a recording surface as a
    @ref CairoPathExtents hash with @c x1, @c y1, @c x2, @c y2.

    @return a @ref CairoPathExtents hash with the ink extents

    @throw CAIRO-ERROR if the surface is not a recording surface
*/
hash<CairoPathExtents> CairoSurface::inkExtents() {
    return surface->inkExtents(xsink);
}
