#include "QC_CairoSvgReader.h"
#include "QC_CairoContext.h"
#include "CairoSvgReader.h"
#include "CairoContext.h"

//! Reads and renders SVG files using librsvg
/**
    Provides SVG loading and rendering capabilities. Requires librsvg to be
    available at compile time (HAVE_RSVG).

    @since %cairo 1.0
*/
qclass CairoSvgReader [arg=QoreCairoSvgReader* reader; ns=Qore::Cairo];

//! Loads an SVG file from a path
/** @param path SVG file path

    @throw CAIRO-ERROR if the SVG cannot be loaded
    @throw MISSING-FEATURE-ERROR if librsvg is not available
*/
CairoSvgReader::constructor(string path) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    ReferenceHolder<QoreCairoSvgReader> holder(new QoreCairoSvgReader(path->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_CAIROSVGREADER, holder.release());
}

//! Loads an SVG from binary data
/** @param data SVG binary data

    @throw CAIRO-ERROR if the SVG cannot be loaded
    @throw MISSING-FEATURE-ERROR if librsvg is not available
*/
CairoSvgReader::constructor(binary data) [flags=NAMED_ARGS] {
    if (!data || data->size() == 0) {
        xsink->raiseException("CAIRO-ERROR", "SVG data is empty");
        return;
    }
    ReferenceHolder<QoreCairoSvgReader> holder(new QoreCairoSvgReader(data, xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_CAIROSVGREADER, holder.release());
}

//! Returns the SVG width
/** @return the intrinsic width of the SVG
*/
float CairoSvgReader::getWidth() {
    return reader->getWidth(xsink);
}

//! Returns the SVG height
/** @return the intrinsic height of the SVG
*/
float CairoSvgReader::getHeight() {
    return reader->getHeight(xsink);
}

//! Returns the SVG dimensions
/** @return a hash with width, height keys
*/
hash<auto> CairoSvgReader::getDimensions() {
    return reader->getDimensions(xsink);
}

//! Renders the SVG onto a Cairo context
/** @param ctx the target drawing context
*/
nothing CairoSvgReader::renderTo(CairoContext[QoreCairoContext] ctx) [flags=NAMED_ARGS] {
    reader->renderTo(*ctx, xsink);
}

//! Returns the ink bounding box of the SVG content
/** Returns the bounding box of the actual visible drawn content as reported by librsvg
    (the same source of truth used when rendering). This is more accurate than measuring
    a recording surface's ink extents, which can include painting-operation bounds that
    extend beyond visible content.

    @return a @ref Qore::Cairo::CairoPathExtents hash with @c x1, @c y1, @c x2, @c y2

    @throw CAIRO-ERROR if the ink geometry cannot be computed
    @throw MISSING-FEATURE-ERROR if librsvg is not available
*/
hash<CairoPathExtents> CairoSvgReader::getInkRect() {
    return reader->getInkRect(xsink);
}

//! Returns SVG metadata
/** @return a hash with metadata fields (width, height)
*/
hash<auto> CairoSvgReader::getMetadata() {
    return reader->getMetadata(xsink);
}

//! Returns whether librsvg is available
/** @return True if librsvg was compiled in
*/
static bool CairoSvgReader::isAvailable() {
    return QoreCairoSvgReader::isAvailable();
}
