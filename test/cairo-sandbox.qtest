#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# The file operations of the cairo module are checked against the filesystem policy of the code that calls them;
# code run with the system policy (SandboxManager::createSystemPolicyCall()) is checked against the system policy.

%modern
%no-child-restrictions

%requires QUnit
%requires Util
%requires FsUtil
%requires cairo

%exec-class CairoSandboxTest

class CairoSandboxTest inherits QUnit::Test {
    private {
        #! the test directory
        string dir;
    }

    constructor() : QUnit::Test("cairo sandbox", "1.0", \ARGV) {
        addTestCase("file operations follow the sandbox of the caller and the system policy in a capability",
            \testFiles());
        set_return_value(main());
    }

    globalSetUp() {
        dir = make_tmp_dir("qore-cairo-sandbox-");
    }

    globalTearDown() {
        remove_tree(dir);
    }

    #! returns a Program whose sandbox denies the filesystem
    private Program getSandboxed() {
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        Program p(PO_NEW_STYLE);
        p.setSandboxManager(sm);
        p.parse("auto sub through(code c) { return c(); }", "cairo-sandbox");
        return p;
    }

    #! runs an operation directly from the sandbox, where it is denied, then in a capability, where it runs
    private auto check(Program p, string name, code op) {
        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), ("through", op),
            name + " called directly from the sandbox is denied");
        return p.callFunction("through", SandboxManager::createSystemPolicyCall(op));
    }

    testFiles() {
        Program p = getSandboxed();
        string svg = dir + DirSep + "image.svg";
        string png = dir + DirSep + "image.png";

        check(p, "CairoSurface::createSvg()", sub () {
            CairoSurface s = CairoSurface::createSvg(svg, 20, 10);
            s.finish();
        });
        assertTrue(is_file(svg), "CairoSurface::createSvg() writes the file in a system-policy capability");

        check(p, "CairoSurface::writeToPng()", sub () {
            CairoSurface s = CairoSurface::createImage(20, 10);
            s.writeToPng(png);
        });
        assertTrue(is_file(png), "CairoSurface::writeToPng() writes the file in a system-policy capability");

        hash<auto> size = check(p, "CairoSurface::createImageFromPng()", hash<auto> sub () {
            CairoSurface s = CairoSurface::createImageFromPng(png);
            return {"width": s.getWidth(), "height": s.getHeight()};
        });
        assertEq({"width": 20, "height": 10}, size,
            "CairoSurface::createImageFromPng() reads the file in a system-policy capability");

        if (CairoSurface::isPdfAvailable()) {
            string pdf = dir + DirSep + "image.pdf";
            check(p, "CairoSurface::createPdf()", sub () {
                CairoSurface s = CairoSurface::createPdf(pdf, 20, 10);
                s.finish();
            });
            assertTrue(is_file(pdf), "CairoSurface::createPdf() writes the file in a system-policy capability");
        }
    }
}
