    private testGradientMultipleStops() {
        auto dp = root.getChildProvider("image").getChildProvider("create");

        # Linear gradient with 4 stops (rainbow-like)
        hash<auto> result = dp.doRequest({
            "width": 200,
            "height": 50,
            "commands": (
                {"op": "linear_gradient", "x0": 0.0, "y0": 0.0, "x1": 200.0, "y1": 0.0,
                 "stops": (
                    {"offset": 0.0, "r": 1.0, "g": 0.0, "b": 0.0},
                    {"offset": 0.33, "r": 1.0, "g": 1.0, "b": 0.0},
                    {"offset": 0.66, "r": 0.0, "g": 1.0, "b": 0.0},
                    {"offset": 1.0, "r": 0.0, "g": 0.0, "b": 1.0},
                 )},
                {"op": "paint"},
            ),
        });
        assertTrue(result.success);
        assertTrue(result.size > 0);
        assertTrue(result.data.substr(0, 4) == <89504e47>);

        # Radial gradient with 3 stops including alpha
        hash<auto> result2 = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "radial_gradient", "cx0": 50.0, "cy0": 50.0, "r0": 0.0,
                 "cx1": 50.0, "cy1": 50.0, "r1": 50.0,
                 "stops": (
                    {"offset": 0.0, "r": 1.0, "g": 1.0, "b": 1.0, "a": 1.0},
                    {"offset": 0.5, "r": 1.0, "g": 0.0, "b": 0.0, "a": 0.7},
                    {"offset": 1.0, "r": 0.0, "g": 0.0, "b": 0.0, "a": 0.0},
                 )},
                {"op": "paint"},
            ),
        });
        assertTrue(result2.success);
        assertTrue(result2.size > 0);
    }

    private testImageResizeNonSquare() {
        auto img_create = root.getChildProvider("image").getChildProvider("create");

        # Create a 200x100 image (2:1 aspect ratio)
        hash<auto> img = img_create.doRequest({
            "width": 200,
            "height": 100,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.5, "b": 0.5},
                {"op": "paint"},
            ),
        });

        auto resize_dp = root.getChildProvider("image").getChildProvider("resize");

        # Resize to different aspect ratio (square)
        hash<auto> result = resize_dp.doRequest({
            "data": img.data,
            "target_width": 150,
            "target_height": 150,
        });
        assertTrue(result.success);
        assertEq(150, result.width);
        assertEq(150, result.height);
        assertTrue(result.size > 0);

        # Resize to tall (reverse aspect)
        hash<auto> result2 = resize_dp.doRequest({
            "data": img.data,
            "target_width": 50,
            "target_height": 200,
        });
        assertTrue(result2.success);
        assertEq(50, result2.width);
        assertEq(200, result2.height);
        assertTrue(result2.size > 0);
    }

