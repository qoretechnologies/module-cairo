    private testCompositeComprehensive() {
        auto img_create = root.getChildProvider("image").getChildProvider("create");

        # Create base image (80x60 red)
        hash<auto> base = img_create.doRequest({
            "width": 80,
            "height": 60,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "paint"},
            ),
        });

        # Create overlay image (40x30 blue)
        hash<auto> overlay = img_create.doRequest({
            "width": 40,
            "height": 30,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 1.0},
                {"op": "paint"},
            ),
        });

        auto comp_dp = root.getChildProvider("image").getChildProvider("composite");

        # Test with input_path variants
        string base_tmp = tmp_location() + "/test_comp_base.png";
        string overlay_tmp = tmp_location() + "/test_comp_overlay.png";
        on_exit {
            if (is_file(base_tmp)) {
                unlink(base_tmp);
            }
            if (is_file(overlay_tmp)) {
                unlink(overlay_tmp);
            }
        }
        {
            File f();
            f.open2(base_tmp, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(base.data);
        }
        {
            File f();
            f.open2(overlay_tmp, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(overlay.data);
        }

        hash<auto> result = comp_dp.doRequest({
            "base_input_path": base_tmp,
            "overlay_input_path": overlay_tmp,
            "x": 10.0,
            "y": 10.0,
        });
        assertTrue(result.success);
        assertEq(80, result.width);
        assertEq(60, result.height);
        assertTrue(result.data.substr(0, 4) == <89504e47>);

        # Test with base_location and overlay_data
        hash<auto> result2 = comp_dp.doRequest({
            "base_location": "file://" + base_tmp,
            "overlay_data": overlay.data,
        });
        assertTrue(result2.success);
        assertEq(80, result2.width);

        # Negative: invalid/corrupt base data
        assertThrows("CAIRO-ERROR", sub () {
            comp_dp.doRequest({
                "base_data": binary("not a png"),
                "overlay_data": overlay.data,
            });
        });

        # Negative: invalid/corrupt overlay data
        assertThrows("CAIRO-ERROR", sub () {
            comp_dp.doRequest({
                "base_data": base.data,
                "overlay_data": binary("not a png"),
            });
        });
    }

