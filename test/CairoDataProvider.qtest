    private testDrawCommands() {
        auto dp = root.getChildProvider("svg").getChildProvider("create");

        # Test all draw commands
        hash<auto> result = dp.doRequest({
            "width": 500.0,
            "height": 500.0,
            "commands": (
                # State management
                {"op": "save"},
                # Source
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 0.0},
                {"op": "set_source_rgba", "r": 1.0, "g": 0.0, "b": 0.0, "a": 0.5},
                # Line style
                {"op": "set_line_width", "width": 2.0},
                {"op": "set_line_cap", "cap": "round"},
                {"op": "set_line_join", "join": "round"},
                {"op": "set_dash", "dashes": (5.0, 3.0), "offset": 0.0},
                {"op": "set_fill_rule", "rule": "even-odd"},
                # Path operations
                {"op": "move_to", "x": 10.0, "y": 10.0},
                {"op": "line_to", "x": 100.0, "y": 100.0},
                {"op": "curve_to", "x1": 150.0, "y1": 50.0, "x2": 200.0, "y2": 150.0,
                 "x3": 250.0, "y3": 100.0},
                {"op": "arc", "x": 300.0, "y": 300.0, "radius": 50.0,
                 "angle1": 0.0, "angle2": 3.14159},
                {"op": "rectangle", "x": 350.0, "y": 350.0, "width": 100.0, "height": 50.0},
                {"op": "close_path"},
                {"op": "stroke_preserve"},
                {"op": "fill_preserve"},
                {"op": "new_path"},
                {"op": "new_sub_path"},
                {"op": "stroke"},
                # Transforms
                {"op": "translate", "x": 50.0, "y": 50.0},
                {"op": "scale", "x": 1.5, "y": 1.5},
                {"op": "rotate", "angle": 0.785},
                {"op": "identity_matrix"},
                # Text
                {"op": "set_font", "family": "sans-serif", "size": 16.0},
                {"op": "text", "text": "Test", "x": 10.0, "y": 400.0, "size": 14.0},
                {"op": "text_path", "text": "Path"},
                # Clip
                {"op": "rectangle", "x": 0.0, "y": 0.0, "width": 500.0, "height": 500.0},
                {"op": "clip_preserve"},
                {"op": "new_path"},
                # Paint
                {"op": "paint"},
                {"op": "paint", "alpha": 0.5},
                {"op": "restore"},
            ),
        });

        assertTrue(result.success);
        assertTrue(result.size > 0);
    }

    private testGradientCommands() {
        auto dp = root.getChildProvider("image").getChildProvider("create");

        hash<auto> result = dp.doRequest({
            "width": 200,
            "height": 200,
            "commands": (
                # Linear gradient
                {"op": "linear_gradient", "x0": 0.0, "y0": 0.0, "x1": 200.0, "y1": 0.0,
                 "stops": (
                    {"offset": 0.0, "r": 1.0, "g": 0.0, "b": 0.0},
                    {"offset": 1.0, "r": 0.0, "g": 0.0, "b": 1.0},
                 )},
                {"op": "rectangle", "x": 0.0, "y": 0.0, "width": 200.0, "height": 100.0},
                {"op": "fill"},
                # Radial gradient with alpha stops
                {"op": "radial_gradient", "cx0": 100.0, "cy0": 150.0, "r0": 0.0,
                 "cx1": 100.0, "cy1": 150.0, "r1": 50.0,
                 "stops": (
                    {"offset": 0.0, "r": 1.0, "g": 1.0, "b": 0.0, "a": 1.0},
                    {"offset": 1.0, "r": 1.0, "g": 0.0, "b": 0.0, "a": 0.0},
                 )},
                {"op": "rectangle", "x": 0.0, "y": 100.0, "width": 200.0, "height": 100.0},
                {"op": "fill"},
            ),
        });

        assertTrue(result.success);
        assertTrue(result.size > 0);
        assertTrue(result.data.substr(0, 4) == <89504e47>);
    }

    private testImageCommand() {
        auto dp = root.getChildProvider("image").getChildProvider("create");

        # Create a small PNG to embed
        hash<auto> src = dp.doRequest({
            "width": 32,
            "height": 32,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "paint"},
            ),
        });

        # Create an image that embeds the source PNG
        hash<auto> result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 1.0, "b": 1.0},
                {"op": "paint"},
                {"op": "image", "data": src.data, "x": 34.0, "y": 34.0,
                 "width": 32.0, "height": 32.0},
            ),
        });

        assertTrue(result.success);
        assertTrue(result.size > 0);
        assertEq(100, result.width);
        assertEq(100, result.height);
    }

    private testMultiPagePs() {
        auto dp = root.getChildProvider("postscript").getChildProvider("create");

        hash<auto> result = dp.doRequest({
            "width": 612.0,
            "height": 792.0,
            "commands": (
                # Page 1
                {"op": "text", "text": "Page 1", "x": 72.0, "y": 720.0, "size": 24.0},
                {"op": "show_page"},
                # Page 2
                {"op": "text", "text": "Page 2", "x": 72.0, "y": 720.0, "size": 24.0},
                {"op": "show_page"},
            ),
        });

        assertTrue(result.success);
        assertTrue(result.size > 0);
        string ps_text = result.data.toString();
        assertTrue(ps_text =~ /%%Pages: 2/);
    }

    private testOutputLocation() {
        auto dp = root.getChildProvider("image").getChildProvider("create");
        string tmp = tmp_location() + "/test_cairo_dp_out.png";

        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }

        # Test with file:// location
        hash<auto> result = dp.doRequest({
            "width": 32,
            "height": 32,
            "output_location": "file://" + tmp,
            "commands": list({"op": "paint"}),
        });

        assertTrue(result.success);
        assertTrue(result.size > 0);
        assertEq("file://" + tmp, result.output_location);
        assertTrue(is_file(tmp));
    }

    private testOperatorAndAntialias() {
        auto dp = root.getChildProvider("image").getChildProvider("create");

        # Test all valid operator values
        list<string> operators = ("clear", "source", "over", "in", "out", "atop",
            "dest", "dest-over", "dest-in", "dest-out", "dest-atop",
            "xor", "add", "saturate");
        foreach string op_name in (operators) {
            hash<auto> result = dp.doRequest({
                "width": 16,
                "height": 16,
                "commands": (
                    {"op": "set_operator", "op_name": op_name},
                    {"op": "paint"},
                ),
            });
            assertTrue(result.success,
                sprintf("operator %y succeeds", op_name));
        }

        # Test all valid antialias values
        list<string> aa_values = ("default", "none", "gray", "subpixel");
        foreach string aa in (aa_values) {
            hash<auto> result = dp.doRequest({
                "width": 16,
                "height": 16,
                "commands": (
                    {"op": "set_antialias", "aa": aa},
                    {"op": "paint"},
                ),
            });
            assertTrue(result.success,
                sprintf("antialias %y succeeds", aa));
        }
    }

    private testInputPath() {
        # Create a PNG first
        auto img_create = root.getChildProvider("image").getChildProvider("create");
        hash<auto> img = img_create.doRequest({
            "width": 64,
            "height": 48,
            "commands": list({"op": "paint"}),
        });

        # Write to a temp file
        string tmp = tmp_location() + "/test_input_path.png";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }
        {
            File f();
            f.open2(tmp, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(img.data);
        }

        # Test image/get-info with input_path
        auto dp = root.getChildProvider("image").getChildProvider("get-info");
        hash<auto> info = dp.doRequest({"input_path": tmp});

        assertTrue(info.success);
        assertEq(64, info.width);
        assertEq(48, info.height);
        assertEq("image", info.type);

        # Test image/get-info with location
        hash<auto> info2 = dp.doRequest({"location": "file://" + tmp});

        assertTrue(info2.success);
        assertEq(64, info2.width);
        assertEq(48, info2.height);
    }

    private testInvalidEnumValues() {
        # Invalid pixel format - caught by DataProvider allowed_values validation
        auto img_dp = root.getChildProvider("image").getChildProvider("create");
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            img_dp.doRequest({
                "width": 32,
                "height": 32,
                "format": "INVALID",
                "commands": list({"op": "paint"}),
            });
        });

        # Invalid line cap
        auto svg_dp = root.getChildProvider("svg").getChildProvider("create");
        assertThrows("CAIRO-ERROR", sub () {
            svg_dp.doRequest({
                "width": 100.0,
                "height": 100.0,
                "commands": (
                    {"op": "set_line_cap", "cap": "invalid"},
                    {"op": "paint"},
                ),
            });
        });

        # Invalid line join
        assertThrows("CAIRO-ERROR", sub () {
            svg_dp.doRequest({
                "width": 100.0,
                "height": 100.0,
                "commands": (
                    {"op": "set_line_join", "join": "invalid"},
                    {"op": "paint"},
                ),
            });
        });

        # Invalid operator
        assertThrows("CAIRO-ERROR", sub () {
            img_dp.doRequest({
                "width": 32,
                "height": 32,
                "commands": (
                    {"op": "set_operator", "op_name": "invalid"},
                    {"op": "paint"},
                ),
            });
        });

        # Invalid antialias
        assertThrows("CAIRO-ERROR", sub () {
            img_dp.doRequest({
                "width": 32,
                "height": 32,
                "commands": (
                    {"op": "set_antialias", "aa": "invalid"},
                    {"op": "paint"},
                ),
            });
        });
    }

    private testSvgConversionOutputPath() {
        if (!CairoSvgReader::isAvailable()) {
            testSkip("librsvg not available");
        }

        # Create an SVG first
        auto svg_create = root.getChildProvider("svg").getChildProvider("create");
        hash<auto> svg = svg_create.doRequest({
            "width": 100.0,
            "height": 100.0,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "paint"},
            ),
        });

        string tmp = tmp_location() + "/test_svg_to_png_out.png";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }

        # Test svg/to-png with output_path
        auto dp = root.getChildProvider("svg").getChildProvider("to-png");
        hash<auto> result = dp.doRequest({
            "data": svg.data,
            "output_path": tmp,
        });

        assertTrue(result.success);
        assertEq(tmp, result.output_path);
        assertTrue(result.size > 0);
        # Data not returned by default when output_path is set
        assertFalse(exists result.data);
        assertTrue(is_file(tmp));
        # Verify the file is a valid PNG
        binary file_data = ReadOnlyFile::readBinaryFile(tmp);
        assertTrue(file_data.substr(0, 4) == <89504e47>);
    }

    private testMissingCommandParams() {
        auto img_dp = root.getChildProvider("image").getChildProvider("create");

        # move_to without x/y defaults to 0.0, 0.0 (succeeds)
        hash<auto> result = img_dp.doRequest({
            "width": 32,
            "height": 32,
            "commands": (
                {"op": "move_to"},
                {"op": "paint"},
            ),
        });
        assertTrue(result.success);

        # rectangle without width/height uses 0.0 (degenerate, but succeeds)
        result = img_dp.doRequest({
            "width": 32,
            "height": 32,
            "commands": (
                {"op": "rectangle", "x": 0.0, "y": 0.0},
                {"op": "paint"},
            ),
        });
        assertTrue(result.success);

        # curve_to without control points defaults to 0.0
        result = img_dp.doRequest({
            "width": 32,
            "height": 32,
            "commands": (
                {"op": "curve_to"},
                {"op": "paint"},
            ),
        });
        assertTrue(result.success);
    }

    private testWarningsField() {
        # Verify warnings field exists in responses (either NOTHING or a list)
        auto dp = root.getChildProvider("image").getChildProvider("create");
        hash<auto> result = dp.doRequest({
            "width": 32,
            "height": 32,
            "commands": list({"op": "paint"}),
        });

        assertTrue(result.success);
        assertTrue(!exists result.warnings || result.warnings instanceof list);

        # Also verify for info providers
        auto info_dp = root.getChildProvider("image").getChildProvider("get-info");
        hash<auto> info = info_dp.doRequest({"data": result.data});

        assertTrue(info.success);
        assertTrue(!exists info.warnings || info.warnings instanceof list);
    }

    private testPdfCreate() {
        if (!CairoSurface::isPdfAvailable()) {
            testSkip("PDF surface support not available");
        }

        auto dp = root.getChildProvider("pdf").getChildProvider("create");
        assertTrue(dp.getInfo().supports_request);

        hash<auto> result = dp.doRequest({
            "width": 612.0,
            "height": 792.0,
            "commands": (
                {"op": "text", "text": "Hello PDF", "x": 72.0, "y": 720.0,
                 "family": "Courier", "size": 24.0},
            ),
