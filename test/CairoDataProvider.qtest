    private testImageRotate() {
        auto dp = root.getChildProvider("image").getChildProvider("rotate");
        assertTrue(dp.getInfo().supports_request);

        # Create a 100x50 test image
        binary png_data = createTestPng(100, 50);

        # Rotate 90 degrees: output should be ~50x100
        hash<auto> result = dp.doRequest({"data": png_data, "angle": 90.0});
        assertTrue(result.success);
        assertTrue(result.size > 0);
        assertTrue(exists result.data);
        assertEq(50, result.width);
        assertEq(100, result.height);

        # Rotate 180 degrees: output should be 100x50
        result = dp.doRequest({"data": png_data, "angle": 180.0});
        assertTrue(result.success);
        assertEq(100, result.width);
        assertEq(50, result.height);

        # Rotate 45 degrees: output should be larger than original
        result = dp.doRequest({"data": png_data, "angle": 45.0});
        assertTrue(result.success);
        assertTrue(result.width > 100);
        assertTrue(result.height > 50);

        # Rotate 0 degrees: output should be same as original
        result = dp.doRequest({"data": png_data, "angle": 0.0});
        assertTrue(result.success);
        assertEq(100, result.width);
        assertEq(50, result.height);

        # Rotate 360 degrees: output should be same as original
        result = dp.doRequest({"data": png_data, "angle": 360.0});
        assertTrue(result.success);
        assertEq(100, result.width);
        assertEq(50, result.height);

        # With output_path
        string tmp = tmp_location() + "/test_rotate.png";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }
        result = dp.doRequest({"data": png_data, "angle": 90.0, "output_path": tmp});
        assertTrue(result.success);
        assertTrue(is_file(tmp));
    }

    private testSvgCenter() {
        auto dp = root.getChildProvider("svg").getChildProvider("center");
        assertTrue(dp.getInfo().supports_request);

        # Create an SVG with content in the top-left corner of a large canvas
        auto create_dp = root.getChildProvider("svg").getChildProvider("create");
        hash<auto> svg_result = create_dp.doRequest({
            "width": 200.0,
            "height": 200.0,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "rectangle", "x": 10.0, "y": 10.0, "width": 40.0, "height": 80.0},
                {"op": "fill"},
            ),
            "return_data": True,
        });
        assertTrue(svg_result.success);
        assertTrue(exists svg_result.data);

        # Center it - content is 40x80 at (10,10), so canvas should be 80x80
        hash<auto> result = dp.doRequest({
            "data": svg_result.data,
            "return_data": True,
        });
        assertTrue(result.success);
        assertEq(200.0, result.original_width, "original width");
        assertEq(200.0, result.original_height, "original height");
        assertEq(80.0, result.canvas_size, "square canvas = max(ink_w, ink_h)");
        assertTrue(exists result.data);
        assertTrue(result.size > 0);

        # Verify the centered SVG is actually 80x80
        auto info_dp = root.getChildProvider("svg").getChildProvider("get-info");
        hash<auto> info = info_dp.doRequest({"data": result.data});
        assertEq(80.0, info.width, "centered SVG width");
        assertEq(80.0, info.height, "centered SVG height");

        # Already-square content should still center on content bounds
        hash<auto> sq_svg = create_dp.doRequest({
            "width": 100.0,
            "height": 100.0,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 1.0, "b": 0.0},
                {"op": "rectangle", "x": 0.0, "y": 0.0, "width": 50.0, "height": 50.0},
                {"op": "fill"},
            ),
            "return_data": True,
        });
        hash<auto> sq_result = dp.doRequest({
            "data": sq_svg.data,
            "return_data": True,
        });
        assertTrue(sq_result.success);
        assertEq(50.0, sq_result.canvas_size, "square content -> 50x50 canvas");

        # Negative test: no input provided
        assertThrows("REQUIRED-FIELD-GROUP-ERROR", sub () {
            dp.doRequest({});
        });
    }

    private testTextRender() {
        auto dp = root.getChildProvider("text").getChildProvider("render");
        assertTrue(dp.getInfo().supports_request);

        # Basic render with defaults
        hash<auto> result = dp.doRequest({"text": "Hello, World!"});
        assertTrue(result.success);
        assertTrue(result.size > 0);
        assertTrue(exists result.data);
        assertTrue(result.width > 0);
        assertTrue(result.height > 0);

        # Render with explicit font and color
        result = dp.doRequest({
            "text": "Test",
            "family": "sans-serif",
            "size": 24.0,
            "weight": "bold",
            "r": 1.0,
            "g": 0.0,
            "b": 0.0,
            "a": 1.0,
        });
        assertTrue(result.success);
        assertTrue(result.width > 0);
        assertTrue(result.height > 0);

        # Render with background
        result = dp.doRequest({
            "text": "BG Test",
            "bg_r": 0.0,
            "bg_g": 0.0,
            "bg_b": 1.0,
            "bg_a": 1.0,
        });
        assertTrue(result.success);
        assertTrue(result.width > 0);

        # Render with padding - should produce larger image
        hash<auto> no_pad = dp.doRequest({"text": "Pad", "size": 20.0});
        hash<auto> with_pad = dp.doRequest({"text": "Pad", "size": 20.0, "padding": 20});
        assertTrue(with_pad.success);
        assertTrue(with_pad.width > no_pad.width);
        assertTrue(with_pad.height > no_pad.height);

        # With output_path
        string tmp = tmp_location() + "/test_text_render.png";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }
        result = dp.doRequest({"text": "Output test", "output_path": tmp});
        assertTrue(result.success);
        assertTrue(is_file(tmp));
        assertFalse(exists result.data);
    }

    private testNewProvidersHierarchy() {
        # Image container should have new children
        auto img = root.getChildProvider("image");
        list<string> img_children = img.getChildProviderNames();
        assertTrue(inlist("rotate", img_children));
        assertTrue(inlist("to-svg", img_children));
        assertTrue(inlist("to-ps", img_children));
        assertTrue(inlist("to-eps", img_children));
        if (CairoSurface::isPdfAvailable()) {
            assertTrue(inlist("to-pdf", img_children));
        }

        # Text container should have render
        auto text = root.getChildProvider("text");
        list<string> text_children = text.getChildProviderNames();
        assertTrue(inlist("render", text_children));
    }

    private testNewProvidersNegative() {
        # Invalid PNG data for conversions
        binary bad_data = binary("not a png");

        # to-svg with bad data
        auto dp = root.getChildProvider("image").getChildProvider("to-svg");
        assertThrows("CAIRO-ERROR", sub () {
            dp.doRequest({"data": bad_data});
        });

        # to-ps with bad data
        dp = root.getChildProvider("image").getChildProvider("to-ps");
        assertThrows("CAIRO-ERROR", sub () {
            dp.doRequest({"data": bad_data});
        });

        # to-eps with bad data
        dp = root.getChildProvider("image").getChildProvider("to-eps");
        assertThrows("CAIRO-ERROR", sub () {
            dp.doRequest({"data": bad_data});
        });

        # rotate with bad data
        dp = root.getChildProvider("image").getChildProvider("rotate");
        assertThrows("CAIRO-ERROR", sub () {
            dp.doRequest({"data": bad_data, "angle": 90.0});
        });

        # to-pdf with bad data (if available)
        if (CairoSurface::isPdfAvailable()) {
            dp = root.getChildProvider("image").getChildProvider("to-pdf");
            assertThrows("CAIRO-ERROR", sub () {
                dp.doRequest({"data": bad_data});
            });
        }
    }

    private testNewProvidersOutputPaths() {
        binary png_data = createTestPng();

        # Test overwrite for image/rotate
        string tmp = tmp_location() + "/test_overwrite_rotate.png";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }
        CairoActionBase::writeBinaryFile(tmp, png_data);
        auto dp = root.getChildProvider("image").getChildProvider("rotate");
        hash<auto> result = dp.doRequest({
            "input_path": tmp,
            "angle": 90.0,
            "overwrite": True,
        });
        assertTrue(result.success);
        assertEq(tmp, result.output_path);

        # Test return_data=True with output_path for to-svg
        string tmp2 = tmp_location() + "/test_return_data.svg";
        on_exit {
            if (is_file(tmp2)) {
                unlink(tmp2);
            }
        }
        dp = root.getChildProvider("image").getChildProvider("to-svg");
        result = dp.doRequest({
            "data": png_data,
            "output_path": tmp2,
            "return_data": True,
        });
        assertTrue(result.success);
        assertTrue(is_file(tmp2));
        assertTrue(exists result.data);
    }
}
