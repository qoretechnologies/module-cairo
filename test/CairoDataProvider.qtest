    private testCornerCases() {
        # Empty command list
        auto svg_dp = root.getChildProvider("svg").getChildProvider("create");
        hash<auto> result = svg_dp.doRequest({
            "width": 50.0,
            "height": 50.0,
            "commands": list(),
        });
        assertTrue(result.success);
        assertTrue(result.size > 0);

        # Single command
        result = svg_dp.doRequest({
            "width": 50.0,
            "height": 50.0,
            "commands": list({"op": "paint"}),
        });
        assertTrue(result.success);
        assertTrue(result.size > 0);

        # return_data=True even with output path
        string tmp = tmp_location() + "/test_corner_case.svg";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }
        result = svg_dp.doRequest({
            "width": 50.0,
            "height": 50.0,
            "output_path": tmp,
            "return_data": True,
            "commands": list({"op": "paint"}),
        });
        assertTrue(result.success);
        assertTrue(exists result.data);
        assertEq(tmp, result.output_path);
        assertTrue(result.size > 0);

        # return_data=False without output path still returns size
        auto img_dp = root.getChildProvider("image").getChildProvider("create");
        result = img_dp.doRequest({
            "width": 32,
            "height": 32,
            "return_data": False,
            "commands": list({"op": "paint"}),
        });
        assertTrue(result.success);
        assertFalse(exists result.data);
        assertTrue(result.size > 0);

        # Text command with minimal parameters
        result = svg_dp.doRequest({
            "width": 100.0,
            "height": 100.0,
            "commands": list({"op": "text", "text": "", "x": 10.0, "y": 50.0}),
        });
        assertTrue(result.success);
        assertTrue(result.size > 0);

        # Gradient with no stops
        result = img_dp.doRequest({
            "width": 32,
            "height": 32,
            "commands": (
                {"op": "linear_gradient", "x0": 0.0, "y0": 0.0, "x1": 32.0, "y1": 0.0},
                {"op": "paint"},
            ),
        });
        assertTrue(result.success);
        assertTrue(result.size > 0);
    }

    #! Helper: create a simple 64x64 PNG and return binary data
    private binary createTestPng(int w = 64, int h = 64) {
        auto dp = root.getChildProvider("image").getChildProvider("create");
        hash<auto> result = dp.doRequest({
            "width": w,
            "height": h,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "rectangle", "x": 0.0, "y": 0.0, "width": float(w), "height": float(h)},
                {"op": "fill"},
            ),
        });
        return result.data;
    }

    private testImageToPdf() {
        if (!CairoSurface::isPdfAvailable()) {
            testSkip("PDF not available");
        }
        auto dp = root.getChildProvider("image").getChildProvider("to-pdf");
        assertTrue(dp.getInfo().supports_request);

        binary png_data = createTestPng();

        # Basic conversion
        hash<auto> result = dp.doRequest({"data": png_data});
        assertTrue(result.success);
        assertTrue(result.size > 0);
        assertTrue(exists result.data);
        # PDF magic bytes
        string header = result.data.substr(0, 5).toString();
        assertEq("%PDF-", header);

        # With output_path
        string tmp = tmp_location() + "/test_img_to_pdf.pdf";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }
        result = dp.doRequest({"data": png_data, "output_path": tmp});
        assertTrue(result.success);
        assertTrue(is_file(tmp));
        assertFalse(exists result.data);
    }

