    private testTextMeasure() {
        auto dp = root.getChildProvider("text").getChildProvider("measure");
        assertTrue(dp.getInfo().supports_request);

        hash<auto> result = dp.doRequest({
            "text": "Hello",
        });

        assertTrue(result.success);
        assertTrue(result.width > 0.0);
        assertTrue(result.height > 0.0);
        assertTrue(result.x_advance > 0.0);
    }

    private testTextMeasureWithFont() {
        auto dp = root.getChildProvider("text").getChildProvider("measure");

        hash<auto> result = dp.doRequest({
            "text": "Test text",
            "family": "sans-serif",
            "size": 24.0,
            "slant": "normal",
            "weight": "bold",
        });

        assertTrue(result.success);
        assertTrue(result.width > 0.0);
        assertTrue(result.height > 0.0);

        # Larger font should produce larger measurements
        hash<auto> small = dp.doRequest({
            "text": "Test text",
            "size": 10.0,
        });

        assertTrue(result.width > small.width);
    }

    private testFontGetMetrics() {
        auto dp = root.getChildProvider("text").getChildProvider("get-font-metrics");
        assertTrue(dp.getInfo().supports_request);

        hash<auto> result = dp.doRequest({});

        assertTrue(result.success);
        assertTrue(result.ascent > 0.0);
        assertTrue(result.descent >= 0.0);
        assertTrue(result.height > 0.0);
        assertTrue(result.max_x_advance > 0.0);
    }

    private testFontGetMetricsWithFont() {
        auto dp = root.getChildProvider("text").getChildProvider("get-font-metrics");

        hash<auto> result = dp.doRequest({
            "family": "sans-serif",
            "size": 24.0,
            "slant": "italic",
            "weight": "bold",
        });

        assertTrue(result.success);
        assertTrue(result.ascent > 0.0);
        assertTrue(result.height > 0.0);

        # Larger font should have greater height
        hash<auto> small = dp.doRequest({
            "size": 10.0,
        });

        assertTrue(result.height > small.height);
    }

    private testImageResize() {
        # Create a 100x100 image first
        auto img_create = root.getChildProvider("image").getChildProvider("create");
        hash<auto> img = img_create.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "paint"},
            ),
        });

        auto dp = root.getChildProvider("image").getChildProvider("resize");
        assertTrue(dp.getInfo().supports_request);

        hash<auto> result = dp.doRequest({
            "data": img.data,
            "target_width": 50,
            "target_height": 50,
        });

        assertTrue(result.success);
        assertEq(50, result.width);
        assertEq(50, result.height);
        assertTrue(result.size > 0);
        assertTrue(result.data.substr(0, 4) == <89504e47>);
    }

    private testImageCrop() {
        # Create a 100x100 image
        auto img_create = root.getChildProvider("image").getChildProvider("create");
        hash<auto> img = img_create.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 1.0},
                {"op": "paint"},
