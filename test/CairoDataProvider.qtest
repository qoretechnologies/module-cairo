    private testSvgConversionErrors() {
        if (!CairoSvgReader::isAvailable()) {
            testSkip("librsvg not available");
        }

        binary invalid_svg = binary("not valid svg data");

        # SVG-to-PNG with invalid data
        auto to_png = root.getChildProvider("svg").getChildProvider("to-png");
        assertThrows("CAIRO-ERROR", sub () {
            to_png.doRequest({"data": invalid_svg});
        });

        # SVG-to-PS with invalid data
        auto to_ps = root.getChildProvider("svg").getChildProvider("to-ps");
        assertThrows("CAIRO-ERROR", sub () {
            to_ps.doRequest({"data": invalid_svg});
        });

        # SVG-to-EPS with invalid data
        auto to_eps = root.getChildProvider("svg").getChildProvider("to-eps");
        assertThrows("CAIRO-ERROR", sub () {
            to_eps.doRequest({"data": invalid_svg});
        });

        # SVG-to-PDF with invalid data (if available)
        if (CairoSurface::isPdfAvailable()) {
            auto to_pdf = root.getChildProvider("svg").getChildProvider("to-pdf");
            assertThrows("CAIRO-ERROR", sub () {
                to_pdf.doRequest({"data": invalid_svg});
            });
        }
    }

    private testSvgMetadataStructure() {
        if (!CairoSvgReader::isAvailable()) {
            testSkip("librsvg not available");
        }

        # Create an SVG
        auto svg_create = root.getChildProvider("svg").getChildProvider("create");
        hash<auto> svg = svg_create.doRequest({
            "width": 400.0,
            "height": 300.0,
            "commands": (
                {"op": "set_source_rgb", "r": 0.5, "g": 0.5, "b": 0.5},
                {"op": "paint"},
            ),
        });

        # Get info and validate metadata structure
        auto dp = root.getChildProvider("svg").getChildProvider("get-info");
        hash<auto> info = dp.doRequest({"data": svg.data});

        assertTrue(info.success);
        assertTrue(info.metadata instanceof hash);
        assertTrue(exists info.metadata.width, "metadata contains width");
        assertTrue(exists info.metadata.height, "metadata contains height");
    }

    private testActionCatalogCompleteness() {
        list<hash<auto>> actions = DataProviderActionCatalog::getActions("Cairo");
        assertTrue(actions.size() > 0, "Cairo actions are registered");

        foreach hash<auto> action in (actions) {
            assertTrue(action.options.size() > 0,
                sprintf("action %y has at least one option", action.action));
            assertTrue(exists action.output_type,
                sprintf("action %y has output_type set", action.action));
            assertTrue(action.display_name.val(),
                sprintf("action %y has display_name", action.action));
            assertTrue(action.short_desc.val(),
                sprintf("action %y has short_desc", action.action));
            assertTrue(action.desc.val(),
                sprintf("action %y has desc", action.action));
        }
    }

    private testNegativeNewDrawCommands() {
        auto dp = root.getChildProvider("image").getChildProvider("create");

        # Invalid extend value on gradient
        assertThrows("CAIRO-ERROR", "invalid extend", sub () {
            dp.doRequest({
                "width": 32,
                "height": 32,
                "commands": (
                    {"op": "linear_gradient", "x0": 0.0, "y0": 0.0, "x1": 32.0, "y1": 0.0,
                     "stops": (
                        {"offset": 0.0, "r": 1.0, "g": 0.0, "b": 0.0},
                        {"offset": 1.0, "r": 0.0, "g": 0.0, "b": 1.0},
                     ),
                     "extend": "invalid_extend",
                    },
                    {"op": "paint"},
                ),
            });
        });

        # Invalid filter value on gradient
        assertThrows("CAIRO-ERROR", "invalid filter", sub () {
            dp.doRequest({
                "width": 32,
                "height": 32,
                "commands": (
                    {"op": "linear_gradient", "x0": 0.0, "y0": 0.0, "x1": 32.0, "y1": 0.0,
                     "stops": (
                        {"offset": 0.0, "r": 1.0, "g": 0.0, "b": 0.0},
                        {"offset": 1.0, "r": 0.0, "g": 0.0, "b": 1.0},
                     ),
                     "filter": "invalid_filter",
                    },
                    {"op": "paint"},
                ),
            });
        });

        # Image command with location pointing to non-existent file
        assertThrows("FILE-OPEN2-ERROR", sub () {
            dp.doRequest({
                "width": 32,
                "height": 32,
                "commands": (
                    {"op": "image", "location": "file:///nonexistent_path_12345.png"},
                ),
            });
        });

        # Image command without path, data, or location
        assertThrows("CAIRO-ERROR", "requires 'path', 'data', or 'location'", sub () {
            dp.doRequest({
                "width": 32,
                "height": 32,
                "commands": list({"op": "image", "x": 0.0, "y": 0.0}),
            });
        });
    }

    private testSvgToPsComprehensive() {
        if (!CairoSvgReader::isAvailable()) {
            testSkip("librsvg not available");
        }

        auto svg_create = root.getChildProvider("svg").getChildProvider("create");
        hash<auto> svg = svg_create.doRequest({
            "width": 200.0,
            "height": 100.0,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.5, "b": 0.0},
                {"op": "paint"},
            ),
        });

        auto dp = root.getChildProvider("svg").getChildProvider("to-ps");

        # Test with custom width/height (scale to US Letter)
        hash<auto> result = dp.doRequest({
            "data": svg.data,
            "width": 612.0,
            "height": 792.0,
        });
        assertTrue(result.success);
        assertTrue(result.size > 0);
        string ps_text = result.data.toString();
        assertTrue(ps_text =~ /^%!PS-Adobe/);

        # Test with output_path
        string tmp = tmp_location() + "/test_svg_to_ps_out.ps";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }
        hash<auto> result2 = dp.doRequest({
            "data": svg.data,
            "output_path": tmp,
        });
        assertTrue(result2.success);
        assertEq(tmp, result2.output_path);
        assertFalse(exists result2.data);
        assertTrue(is_file(tmp));
        assertTrue(hstat(tmp).size > 0);

        # Test with output_path + return_data=True
        string tmp2 = tmp_location() + "/test_svg_to_ps_out2.ps";
        on_exit {
            if (is_file(tmp2)) {
                unlink(tmp2);
            }
        }
        hash<auto> result3 = dp.doRequest({
            "data": svg.data,
            "output_path": tmp2,
            "return_data": True,
        });
        assertTrue(result3.success);
        assertEq(tmp2, result3.output_path);
        assertTrue(exists result3.data);
        assertTrue(is_file(tmp2));

        # Negative: zero/negative dimensions
        assertThrows("CAIRO-ERROR", "positive", sub () {
            dp.doRequest({
                "data": svg.data,
                "width": 0.0,
                "height": 100.0,
            });
        });

        assertThrows("CAIRO-ERROR", "positive", sub () {
            dp.doRequest({
                "data": svg.data,
                "width": 100.0,
                "height": -50.0,
            });
        });
    }

