    private testImageComposite() {
        auto img_create = root.getChildProvider("image").getChildProvider("create");

        # Create base image (100x100 red)
        hash<auto> base = img_create.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "paint"},
            ),
        });

        # Create overlay image (50x50 blue)
        hash<auto> overlay = img_create.doRequest({
            "width": 50,
            "height": 50,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 1.0},
                {"op": "paint"},
            ),
        });

        auto dp = root.getChildProvider("image").getChildProvider("composite");
        assertTrue(dp.getInfo().supports_request);

        hash<auto> result = dp.doRequest({
            "base_data": base.data,
            "overlay_data": overlay.data,
            "x": 25.0,
            "y": 25.0,
            "alpha": 0.5,
        });

        assertTrue(result.success);
        assertEq(100, result.width);
        assertEq(100, result.height);
        assertTrue(result.size > 0);
        assertTrue(result.data.substr(0, 4) == <89504e47>);

        # Test with overlay scaling
        hash<auto> result2 = dp.doRequest({
            "base_data": base.data,
            "overlay_data": overlay.data,
            "x": 0.0,
            "y": 0.0,
            "overlay_width": 100,
            "overlay_height": 100,
        });

        assertTrue(result2.success);
        assertEq(100, result2.width);
    }

    private testNewDrawCommands() {
        auto dp = root.getChildProvider("image").getChildProvider("create");

        # Test arc_negative
        hash<auto> result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 0.0},
                {"op": "arc_negative", "x": 50.0, "y": 50.0, "radius": 30.0,
                 "angle1": 0.0, "angle2": -3.14159},
                {"op": "stroke"},
            ),
        });
        assertTrue(result.success);

        # Test set_font_size standalone
        result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_font_size", "size": 20.0},
                {"op": "move_to", "x": 10.0, "y": 50.0},
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 0.0},
                {"op": "text", "text": "Hi", "x": 10.0, "y": 50.0},
            ),
        });
        assertTrue(result.success);

        # Test set_matrix with identity matrix
        result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_matrix", "xx": 1.0, "yx": 0.0, "xy": 0.0, "yy": 1.0,
                 "x0": 0.0, "y0": 0.0},
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "paint"},
            ),
        });
        assertTrue(result.success);

        # Test transform command
        result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "transform", "xx": 1.0, "yx": 0.0, "xy": 0.5, "yy": 1.0,
                 "x0": 0.0, "y0": 0.0},
                {"op": "set_source_rgb", "r": 0.0, "g": 1.0, "b": 0.0},
                {"op": "rectangle", "x": 10.0, "y": 10.0, "width": 30.0, "height": 30.0},
                {"op": "fill"},
            ),
        });
        assertTrue(result.success);

        # Test copy_page (on PS surface via postscript provider)
        auto ps_dp = root.getChildProvider("postscript").getChildProvider("create");
        result = ps_dp.doRequest({
            "width": 612.0,
            "height": 792.0,
            "commands": (
                {"op": "text", "text": "Page", "x": 72.0, "y": 720.0, "size": 24.0},
                {"op": "copy_page"},
                {"op": "show_page"},
            ),
        });
        assertTrue(result.success);
    }

    private testNegative() {
        # Missing op key
        auto svg_dp = root.getChildProvider("svg").getChildProvider("create");
        assertThrows("CAIRO-ERROR", "missing 'op'", sub () {
            svg_dp.doRequest({
                "width": 100.0,
                "height": 100.0,
                "commands": list({"r": 1.0}),
            });
        });

        # Unknown op
        assertThrows("CAIRO-ERROR", "unknown draw command", sub () {
            svg_dp.doRequest({
                "width": 100.0,
                "height": 100.0,
                "commands": list({"op": "bogus_operation"}),
            });
        });

        # Negative dimensions for SVG create
        assertThrows("CAIRO-ERROR", "positive", sub () {
            svg_dp.doRequest({
                "width": -100.0,
                "height": 100.0,
                "commands": list(),
            });
        });

        # Negative dimensions for image create
        auto img_dp = root.getChildProvider("image").getChildProvider("create");
        assertThrows("CAIRO-ERROR", "positive", sub () {
            img_dp.doRequest({
                "width": -10,
                "height": 10,
                "commands": list(),
            });
        });

        # Negative dimensions for PostScript create
        auto ps_dp = root.getChildProvider("postscript").getChildProvider("create");
        assertThrows("CAIRO-ERROR", "positive", sub () {
            ps_dp.doRequest({
                "width": -612.0,
                "height": 792.0,
                "commands": list(),
            });
        });

        # Image command without path or data
        assertThrows("CAIRO-ERROR", "requires 'path', 'data', or 'location'", sub () {
            img_dp.doRequest({
                "width": 32,
                "height": 32,
                "commands": list({"op": "image", "x": 0.0, "y": 0.0}),
            });
        });

        # Image get-info with non-PNG data
        auto info_dp = root.getChildProvider("image").getChildProvider("get-info");
        assertThrows("CAIRO-ERROR", sub () {
            info_dp.doRequest({"data": binary("not a png")});
        });

        # Image draw with non-PNG data
        auto draw_dp = root.getChildProvider("image").getChildProvider("draw");
        assertThrows("CAIRO-ERROR", sub () {
            draw_dp.doRequest({
                "data": binary("not a png"),
                "commands": list({"op": "paint"}),
            });
        });
    }

    private testNegativeNewFeatures() {
        # Invalid PDF dimensions
        if (CairoSurface::isPdfAvailable()) {
            auto pdf_dp = root.getChildProvider("pdf").getChildProvider("create");
            assertThrows("CAIRO-ERROR", "positive", sub () {
                pdf_dp.doRequest({
                    "width": 0.0,
                    "height": 792.0,
                    "commands": list(),
                });
            });
        }

        # Resize to zero dimensions
        auto img_create = root.getChildProvider("image").getChildProvider("create");
        hash<auto> img = img_create.doRequest({
            "width": 32,
            "height": 32,
            "commands": list({"op": "paint"}),
        });

        auto resize_dp = root.getChildProvider("image").getChildProvider("resize");
        assertThrows("CAIRO-ERROR", "positive", sub () {
            resize_dp.doRequest({
                "data": img.data,
                "target_width": 0,
                "target_height": 50,
            });
        });

        # Crop dimensions exceeding image bounds
        auto crop_dp = root.getChildProvider("image").getChildProvider("crop");
        assertThrows("CAIRO-ERROR", "exceeds", sub () {
            crop_dp.doRequest({
                "data": img.data,
                "x": 20,
                "y": 20,
                "crop_width": 50,
                "crop_height": 50,
            });
        });

        # Crop with zero dimensions
        assertThrows("CAIRO-ERROR", "positive", sub () {
            crop_dp.doRequest({
                "data": img.data,
                "x": 0,
                "y": 0,
                "crop_width": 0,
                "crop_height": 10,
            });
        });
    }

    private testOverwrite() {
        # Test overwrite with image/draw
        string tmp_draw = tmp_location() + "/test_overwrite_draw.png";
        on_exit {
            if (is_file(tmp_draw)) {
                unlink(tmp_draw);
            }
        }

        # Create an initial image file
        auto img_create = root.getChildProvider("image").getChildProvider("create");
        hash<auto> img = img_create.doRequest({
            "width": 50,
            "height": 50,
            "output_path": tmp_draw,
            "commands": list({"op": "paint"}),
        });
        assertTrue(img.success);
        assertTrue(is_file(tmp_draw));

        # Draw on it using input_path + overwrite (no output_path)
        auto img_draw = root.getChildProvider("image").getChildProvider("draw");
        hash<auto> draw_result = img_draw.doRequest({
            "input_path": tmp_draw,
            "overwrite": True,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "rectangle", "x": 10.0, "y": 10.0, "width": 30.0, "height": 30.0},
                {"op": "fill"},
            ),
        });
        assertTrue(draw_result.success);
        assertEq(tmp_draw, draw_result.output_path);
        # With overwrite + no return_data, data should not be in response
        assertFalse(exists draw_result.data);
        # File should still exist and have data
        assertTrue(is_file(tmp_draw));
        assertTrue(hstat(tmp_draw).size > 0);

        # Test overwrite with image/resize
        string tmp_resize = tmp_location() + "/test_overwrite_resize.png";
        on_exit {
            if (is_file(tmp_resize)) {
                unlink(tmp_resize);
            }
        }

        img_create.doRequest({
            "width": 100,
            "height": 100,
            "output_path": tmp_resize,
            "commands": list({"op": "paint"}),
        });
        assertTrue(is_file(tmp_resize));

        auto resize_dp = root.getChildProvider("image").getChildProvider("resize");
        hash<auto> resize_result = resize_dp.doRequest({
            "input_path": tmp_resize,
            "overwrite": True,
            "target_width": 50,
            "target_height": 50,
        });
        assertTrue(resize_result.success);
        assertEq(tmp_resize, resize_result.output_path);
        assertEq(50, resize_result.width);
        assertEq(50, resize_result.height);
        assertFalse(exists resize_result.data);

        # Test overwrite with image/crop
        string tmp_crop = tmp_location() + "/test_overwrite_crop.png";
        on_exit {
            if (is_file(tmp_crop)) {
                unlink(tmp_crop);
            }
        }

        img_create.doRequest({
            "width": 100,
            "height": 100,
            "output_path": tmp_crop,
            "commands": list({"op": "paint"}),
        });
        assertTrue(is_file(tmp_crop));

        auto crop_dp = root.getChildProvider("image").getChildProvider("crop");
        hash<auto> crop_result = crop_dp.doRequest({
            "input_path": tmp_crop,
            "overwrite": True,
            "x": 10,
            "y": 10,
            "crop_width": 50,
            "crop_height": 50,
        });
        assertTrue(crop_result.success);
        assertEq(tmp_crop, crop_result.output_path);
        assertEq(50, crop_result.width);
        assertEq(50, crop_result.height);
        assertFalse(exists crop_result.data);

        # Test overwrite with return_data=True
        string tmp_both = tmp_location() + "/test_overwrite_both.png";
        on_exit {
            if (is_file(tmp_both)) {
                unlink(tmp_both);
            }
        }

        img_create.doRequest({
            "width": 64,
            "height": 64,
            "output_path": tmp_both,
            "commands": list({"op": "paint"}),
        });

        hash<auto> both_result = img_draw.doRequest({
            "input_path": tmp_both,
            "overwrite": True,
            "return_data": True,
            "commands": list({"op": "paint"}),
        });
        assertTrue(both_result.success);
        assertEq(tmp_both, both_result.output_path);
        assertTrue(exists both_result.data);
        assertTrue(both_result.size > 0);
    }

    private testNegativeValidation() {
        # Invalid slant value for text measurement - caught by DataProvider allowed_values
        auto text_dp = root.getChildProvider("text").getChildProvider("measure");
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            text_dp.doRequest({
                "text": "Hello",
                "slant": "invalid_slant",
            });
        });

        # Invalid weight value for text measurement
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            text_dp.doRequest({
                "text": "Hello",
                "weight": "invalid_weight",
            });
        });

        # Invalid slant for font metrics
        auto font_dp = root.getChildProvider("text").getChildProvider("get-font-metrics");
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            font_dp.doRequest({
                "slant": "invalid_slant",
            });
        });

        # Negative font size for text measurement
        assertThrows("CAIRO-ERROR", "positive", sub () {
            text_dp.doRequest({
                "text": "Hello",
                "size": -5.0,
            });
        });

        # Zero font size for font metrics
        assertThrows("CAIRO-ERROR", "positive", sub () {
            font_dp.doRequest({
                "size": 0.0,
            });
        });

        # Composite with invalid alpha
        auto img_create = root.getChildProvider("image").getChildProvider("create");
        hash<auto> img = img_create.doRequest({
            "width": 32,
            "height": 32,
            "commands": list({"op": "paint"}),
        });

        auto comp_dp = root.getChildProvider("image").getChildProvider("composite");
        assertThrows("CAIRO-ERROR", "alpha", sub () {
            comp_dp.doRequest({
                "base_data": img.data,
                "overlay_data": img.data,
                "alpha": 1.5,
            });
        });

        assertThrows("CAIRO-ERROR", "alpha", sub () {
            comp_dp.doRequest({
                "base_data": img.data,
                "overlay_data": img.data,
                "alpha": -0.1,
            });
        });

        # Resize with corrupt data
        auto resize_dp = root.getChildProvider("image").getChildProvider("resize");
        assertThrows("CAIRO-ERROR", sub () {
            resize_dp.doRequest({
                "data": binary("not a png"),
                "target_width": 50,
                "target_height": 50,
            });
        });

        # Crop with corrupt data
        auto crop_dp = root.getChildProvider("image").getChildProvider("crop");
        assertThrows("CAIRO-ERROR", sub () {
            crop_dp.doRequest({
                "data": binary("not a png"),
                "x": 0,
                "y": 0,
                "crop_width": 10,
                "crop_height": 10,
            });
        });

        # Crop with negative x/y
        assertThrows("CAIRO-ERROR", "exceeds", sub () {
            crop_dp.doRequest({
                "data": img.data,
                "x": -5,
                "y": 0,
                "crop_width": 10,
                "crop_height": 10,
            });
        });
    }

    private testImageResizeUpscale() {
        # Create a small image and upscale it
        auto img_create = root.getChildProvider("image").getChildProvider("create");
        hash<auto> img = img_create.doRequest({
            "width": 32,
            "height": 32,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "paint"},
            ),
        });

        auto resize_dp = root.getChildProvider("image").getChildProvider("resize");
        hash<auto> result = resize_dp.doRequest({
            "data": img.data,
            "target_width": 128,
            "target_height": 128,
        });

        assertTrue(result.success);
        assertEq(128, result.width);
        assertEq(128, result.height);
        assertTrue(result.size > 0);
        # Upscaled image should be larger than original
        assertTrue(result.size > img.size);
    }

    private testCompositeAlphaZero() {
        auto img_create = root.getChildProvider("image").getChildProvider("create");

        # Create base (red) and overlay (blue)
        hash<auto> base = img_create.doRequest({
            "width": 32,
            "height": 32,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "paint"},
            ),
        });
        hash<auto> overlay = img_create.doRequest({
            "width": 32,
            "height": 32,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 1.0},
                {"op": "paint"},
            ),
        });

        auto comp_dp = root.getChildProvider("image").getChildProvider("composite");
        hash<auto> result = comp_dp.doRequest({
            "base_data": base.data,
            "overlay_data": overlay.data,
            "alpha": 0.0,
        });

        assertTrue(result.success);
        assertEq(32, result.width);
        assertEq(32, result.height);
        # With alpha=0, result should be same size as base (overlay invisible)
        assertTrue(result.size > 0);
    }

    private testCompositePartialOverlayDims() {
        auto img_create = root.getChildProvider("image").getChildProvider("create");
        hash<auto> img = img_create.doRequest({
            "width": 32,
            "height": 32,
            "commands": list({"op": "paint"}),
        });

        auto comp_dp = root.getChildProvider("image").getChildProvider("composite");
        # Only overlay_width, no overlay_height — should produce a warning
        hash<auto> result = comp_dp.doRequest({
            "base_data": img.data,
            "overlay_data": img.data,
            "overlay_width": 16,
        });

        assertTrue(result.success);
        assertTrue(exists result.warnings);
        assertTrue(result.warnings.size() > 0);
        assertTrue(result.warnings[0] =~ /overlay_width/);
    }

    private testNewProviderOutputPaths() {
        auto img_create = root.getChildProvider("image").getChildProvider("create");
        hash<auto> img = img_create.doRequest({
            "width": 64,
            "height": 64,
            "commands": list({"op": "paint"}),
        });

        # Resize with output_path
        string tmp_resize = tmp_location() + "/test_resize_output.png";
        on_exit {
            if (is_file(tmp_resize)) {
                unlink(tmp_resize);
            }
        }

        auto resize_dp = root.getChildProvider("image").getChildProvider("resize");
        hash<auto> result = resize_dp.doRequest({
            "data": img.data,
            "target_width": 32,
            "target_height": 32,
            "output_path": tmp_resize,
        });
        assertTrue(result.success);
        assertEq(tmp_resize, result.output_path);
        assertFalse(exists result.data);
        assertTrue(is_file(tmp_resize));

        # Crop with output_path
        string tmp_crop = tmp_location() + "/test_crop_output.png";
        on_exit {
            if (is_file(tmp_crop)) {
                unlink(tmp_crop);
            }
        }

        auto crop_dp = root.getChildProvider("image").getChildProvider("crop");
        result = crop_dp.doRequest({
            "data": img.data,
            "x": 0,
            "y": 0,
            "crop_width": 32,
            "crop_height": 32,
            "output_path": tmp_crop,
        });
        assertTrue(result.success);
        assertEq(tmp_crop, result.output_path);
        assertFalse(exists result.data);
        assertTrue(is_file(tmp_crop));

        # Composite with output_path
        string tmp_comp = tmp_location() + "/test_composite_output.png";
        on_exit {
            if (is_file(tmp_comp)) {
                unlink(tmp_comp);
            }
        }

        auto comp_dp = root.getChildProvider("image").getChildProvider("composite");
        result = comp_dp.doRequest({
            "base_data": img.data,
            "overlay_data": img.data,
            "output_path": tmp_comp,
        });
        assertTrue(result.success);
        assertEq(tmp_comp, result.output_path);
        assertFalse(exists result.data);
        assertTrue(is_file(tmp_comp));
    }

    private testActionCatalogOptions() {
        # Verify actions have options registered
        list<hash<auto>> actions = DataProviderActionCatalog::getActions("Cairo");
        assertTrue(actions.size() > 0, "Cairo actions are registered");
        foreach hash<auto> action in (actions) {
            assertTrue(action.options.size() > 0,
                sprintf("action %y has options", action.action));
            assertTrue(exists action.output_type,
                sprintf("action %y has output_type", action.action));
        }
    }

    private testNewDrawCommandsPhase2() {
        auto dp = root.getChildProvider("image").getChildProvider("create");

        # Test rel_move_to and rel_line_to
        hash<auto> result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 0.0},
                {"op": "set_line_width", "width": 2.0},
                {"op": "move_to", "x": 10.0, "y": 10.0},
                {"op": "rel_line_to", "dx": 50.0, "dy": 0.0},
                {"op": "rel_line_to", "dx": 0.0, "dy": 50.0},
                {"op": "stroke"},
            ),
        });
        assertTrue(result.success, "rel_line_to succeeds");

        # Test rel_move_to
        result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 0.0},
                {"op": "move_to", "x": 10.0, "y": 10.0},
                {"op": "rel_move_to", "dx": 20.0, "dy": 20.0},
                {"op": "line_to", "x": 80.0, "y": 80.0},
                {"op": "stroke"},
            ),
        });
        assertTrue(result.success, "rel_move_to succeeds");

        # Test rel_curve_to
        result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 0.0},
                {"op": "move_to", "x": 10.0, "y": 50.0},
                {"op": "rel_curve_to", "dx1": 20.0, "dy1": -40.0,
                 "dx2": 60.0, "dy2": -40.0, "dx3": 80.0, "dy3": 0.0},
                {"op": "stroke"},
            ),
        });
        assertTrue(result.success, "rel_curve_to succeeds");

        # Test set_miter_limit
        result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_line_width", "width": 10.0},
                {"op": "set_line_join", "join": "miter"},
                {"op": "set_miter_limit", "limit": 5.0},
                {"op": "move_to", "x": 10.0, "y": 50.0},
                {"op": "line_to", "x": 50.0, "y": 10.0},
                {"op": "line_to", "x": 90.0, "y": 50.0},
                {"op": "stroke"},
            ),
        });
        assertTrue(result.success, "set_miter_limit succeeds");

        # Test set_tolerance
        result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_tolerance", "tolerance": 0.5},
                {"op": "arc", "x": 50.0, "y": 50.0, "radius": 30.0,
                 "angle1": 0.0, "angle2": 6.28318},
                {"op": "stroke"},
            ),
        });
        assertTrue(result.success, "set_tolerance succeeds");

        # Test push_group and pop_group_to_source
        result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 1.0, "b": 1.0},
                {"op": "paint"},
                {"op": "push_group"},
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "rectangle", "x": 10.0, "y": 10.0, "width": 80.0, "height": 80.0},
                {"op": "fill"},
                {"op": "pop_group_to_source"},
                {"op": "paint", "alpha": 0.5},
            ),
        });
        assertTrue(result.success, "push_group/pop_group_to_source succeeds");

        # Test reset_clip
        result = dp.doRequest({
            "width": 100,
            "height": 100,
            "commands": (
                {"op": "rectangle", "x": 10.0, "y": 10.0, "width": 50.0, "height": 50.0},
                {"op": "clip"},
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "paint"},
                {"op": "reset_clip"},
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 1.0},
                {"op": "rectangle", "x": 60.0, "y": 60.0, "width": 30.0, "height": 30.0},
                {"op": "fill"},
            ),
        });
        assertTrue(result.success, "reset_clip succeeds");
    }

    private testGradientExtendFilter() {
        auto dp = root.getChildProvider("image").getChildProvider("create");

        # Test linear gradient with extend and filter
        hash<auto> result = dp.doRequest({
            "width": 200,
            "height": 200,
            "commands": (
                {"op": "linear_gradient", "x0": 0.0, "y0": 0.0, "x1": 50.0, "y1": 0.0,
                 "stops": (
                    {"offset": 0.0, "r": 1.0, "g": 0.0, "b": 0.0},
                    {"offset": 1.0, "r": 0.0, "g": 0.0, "b": 1.0},
                 ),
                 "extend": "repeat",
                 "filter": "bilinear",
                },
                {"op": "rectangle", "x": 0.0, "y": 0.0, "width": 200.0, "height": 100.0},
                {"op": "fill"},
            ),
        });
        assertTrue(result.success, "linear gradient with extend/filter succeeds");

        # Test radial gradient with extend
        result = dp.doRequest({
            "width": 200,
            "height": 200,
            "commands": (
                {"op": "radial_gradient", "cx0": 100.0, "cy0": 100.0, "r0": 10.0,
                 "cx1": 100.0, "cy1": 100.0, "r1": 50.0,
                 "stops": (
                    {"offset": 0.0, "r": 1.0, "g": 1.0, "b": 0.0},
                    {"offset": 1.0, "r": 0.0, "g": 0.5, "b": 0.0},
                 ),
                 "extend": "reflect",
                },
                {"op": "rectangle", "x": 0.0, "y": 0.0, "width": 200.0, "height": 200.0},
                {"op": "fill"},
            ),
        });
        assertTrue(result.success, "radial gradient with extend succeeds");

        # Test all valid extend values
        list<string> extends = ("none", "repeat", "reflect", "pad");
        foreach string ext in (extends) {
            result = dp.doRequest({
                "width": 32,
                "height": 32,
                "commands": (
                    {"op": "linear_gradient", "x0": 0.0, "y0": 0.0, "x1": 16.0, "y1": 0.0,
                     "stops": (
                        {"offset": 0.0, "r": 1.0, "g": 0.0, "b": 0.0},
                        {"offset": 1.0, "r": 0.0, "g": 0.0, "b": 1.0},
                     ),
                     "extend": ext,
                    },
                    {"op": "paint"},
                ),
            });
            assertTrue(result.success, sprintf("extend %y succeeds", ext));
        }

        # Test all valid filter values
        list<string> filters = ("fast", "good", "best", "nearest", "bilinear");
        foreach string flt in (filters) {
            result = dp.doRequest({
                "width": 32,
                "height": 32,
                "commands": (
                    {"op": "linear_gradient", "x0": 0.0, "y0": 0.0, "x1": 32.0, "y1": 0.0,
                     "stops": (
                        {"offset": 0.0, "r": 1.0, "g": 0.0, "b": 0.0},
                        {"offset": 1.0, "r": 0.0, "g": 0.0, "b": 1.0},
                     ),
                     "filter": flt,
                    },
                    {"op": "paint"},
                ),
            });
            assertTrue(result.success, sprintf("filter %y succeeds", flt));
        }
    }

    private testImageCommandLocation() {
        auto dp = root.getChildProvider("image").getChildProvider("create");

        # Create a small PNG to use as embedded image
        hash<auto> src = dp.doRequest({
            "width": 16,
            "height": 16,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 1.0, "b": 0.0},
                {"op": "paint"},
            ),
        });

        # Write to a temp file
        string tmp = tmp_location() + "/test_img_location.png";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }
        {
            File f();
            f.open2(tmp, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(src.data);
        }

        # Test image command with location
        hash<auto> result = dp.doRequest({
            "width": 64,
            "height": 64,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 1.0, "b": 1.0},
                {"op": "paint"},
                {"op": "image", "location": "file://" + tmp, "x": 24.0, "y": 24.0},
            ),
        });
        assertTrue(result.success, "image command with location succeeds");
        assertEq(64, result.width);
        assertEq(64, result.height);
    }

    private testSvgToPdf() {
        if (!CairoSvgReader::isAvailable()) {
            testSkip("librsvg not available");
        }
        if (!CairoSurface::isPdfAvailable()) {
            testSkip("PDF surface support not available");
        }

        # Verify to-pdf child is registered
        auto svg = root.getChildProvider("svg");
        assertTrue(inlist("to-pdf", svg.getChildProviderNames()));

        # Create an SVG first
        auto svg_create = root.getChildProvider("svg").getChildProvider("create");
        hash<auto> svg_data = svg_create.doRequest({
            "width": 200.0,
            "height": 100.0,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "rectangle", "x": 0.0, "y": 0.0, "width": 200.0, "height": 100.0},
                {"op": "fill"},
            ),
        });

        # Convert to PDF
        auto dp = root.getChildProvider("svg").getChildProvider("to-pdf");
        assertTrue(dp.getInfo().supports_request);
        hash<auto> result = dp.doRequest({"data": svg_data.data});

        assertTrue(result.success);
        assertTrue(result.size > 0);
        assertTrue(exists result.data);
        # Verify PDF magic bytes
        string header = result.data.substr(0, 5).toString();
        assertEq("%PDF-", header);

        # Test with custom width/height
        hash<auto> result2 = dp.doRequest({
            "data": svg_data.data,
            "width": 612.0,
            "height": 792.0,
        });
        assertTrue(result2.success);
        assertTrue(result2.size > 0);
        string header2 = result2.data.substr(0, 5).toString();
        assertEq("%PDF-", header2);

        # Test with output_path
        string tmp = tmp_location() + "/test_svg_to_pdf.pdf";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }
        hash<auto> result3 = dp.doRequest({
            "data": svg_data.data,
            "output_path": tmp,
        });
        assertTrue(result3.success);
        assertEq(tmp, result3.output_path);
        assertTrue(is_file(tmp));

        # Test negative dimensions
        assertThrows("CAIRO-ERROR", "positive", sub () {
            dp.doRequest({
                "data": svg_data.data,
                "width": -100.0,
                "height": 100.0,
            });
        });
    }

    private testMaskSurface() {
        auto dp = root.getChildProvider("image").getChildProvider("create");

        # Create a mask image (white with alpha gradient effect)
        hash<auto> mask = dp.doRequest({
            "width": 32,
            "height": 32,
            "format": "ARGB32",
            "commands": (
                {"op": "set_source_rgba", "r": 1.0, "g": 1.0, "b": 1.0, "a": 0.5},
                {"op": "paint"},
            ),
        });

        # Use mask_surface with data
        hash<auto> result = dp.doRequest({
            "width": 64,
            "height": 64,
            "commands": (
                {"op": "set_source_rgb", "r": 1.0, "g": 0.0, "b": 0.0},
                {"op": "mask_surface", "data": mask.data, "x": 16.0, "y": 16.0},
            ),
        });
        assertTrue(result.success);
        assertTrue(result.size > 0);
        assertTrue(result.data.substr(0, 4) == <89504e47>);

        # Test mask_surface with location
        string tmp = tmp_location() + "/test_mask.png";
        on_exit {
            if (is_file(tmp)) {
                unlink(tmp);
            }
        }
        {
            File f();
            f.open2(tmp, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(mask.data);
        }

        hash<auto> result2 = dp.doRequest({
            "width": 64,
            "height": 64,
            "commands": (
                {"op": "set_source_rgb", "r": 0.0, "g": 0.0, "b": 1.0},
                {"op": "mask_surface", "location": "file://" + tmp},
            ),
        });
        assertTrue(result2.success);
        assertTrue(result2.size > 0);

        # Negative: mask_surface without path/data/location
        assertThrows("CAIRO-ERROR", "mask_surface command requires", sub () {
            dp.doRequest({
                "width": 32,
                "height": 32,
                "commands": list({"op": "mask_surface", "x": 0.0, "y": 0.0}),
            });
        });
    }

